import "message_showcase_text.cblc";
import "message_showcase_ledger.cblc";
import "message_showcase_memory.cblc";
import "message_showcase_refs.cblc";

int module_count;
int module_delta;

void main()
{
    module_count = 3;
    module_delta = 1;
    display("CBL-C STARTER SHOWCASE");
    showcase_text();
    try
    {
        showcase_portfolio();
    }
    catch (int portfolio_failure)
    {
        display("Portfolio exception handled");
    }
    showcase_memory();
    adjust_module_count(module_count, module_delta);
    display("Modules");
    display(module_count);
    display("SHOWCASE READY");
    return;
}
