import "message_showcase_text.cblc";
import "message_showcase_ledger.cblc";
import "message_showcase_memory.cblc";

int module_count;
vector<int> score_history;
int vector_size;
int vector_first;
int vector_last;

void showcase_vector()
{
    score_history.reserve(4);
    score_history.push_back(72);
    score_history.emplace_back(86);
    score_history.insert(1, 94);
    vector_size = score_history.size();
    vector_first = score_history.front();
    vector_last = score_history.back();
    display("Vector size");
    display(vector_size);
    display("Vector first");
    display(vector_first);
    display("Vector last");
    display(vector_last);
    return;
}

void main()
{
    module_count = 3;
    display("CBL-C STARTER SHOWCASE");
    showcase_text();
    showcase_vector();
    showcase_portfolio();
    showcase_memory();
    display("Modules");
    display(module_count);
    display("SHOWCASE READY");
    return;
}
