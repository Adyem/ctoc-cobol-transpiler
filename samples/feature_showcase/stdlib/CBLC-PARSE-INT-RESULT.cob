>>SOURCE FORMAT IS FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CBLC-PARSE-INT-RESULT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 F-RESULT.
       05 F-RESULT-CBLC-USER-VALUE PIC S9(9).
       05 F-RESULT-CONSUMED PIC S9(9).
       05 F-RESULT-ERROR PIC S9(9).
       01 F-INDEX PIC S9(9) COMP-5.
       01 F-NEGATIVE PIC S9(9) COMP-5.
       01 F-SEEN-DIGIT PIC S9(9) COMP-5.
       01 F-DIGIT-COUNT PIC S9(9) COMP-5.
       01 F-DIGIT PIC S9(9) COMP-5.
       01 F-CURRENT PIC X(1).
       01 CBLC-PTR-CURSOR USAGE POINTER VALUE NULL.
       01 CBLC-PTR-OFFSET PIC S9(9) VALUE 0.
       01 CBLC-PTR-CHAR BASED PIC X.
       01 CBLC-PTR-INT BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR BASED USAGE POINTER.
       01 CBLC-PTR-CHAR-2 BASED PIC X.
       01 CBLC-PTR-INT-2 BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR-2 BASED USAGE POINTER.
       LINKAGE SECTION.
       01 F-SOURCE PIC X(255).
       01 F-SOURCE-LENGTH PIC S9(9) COMP-5.
       01 CBLC-RETURN-F.
       05 CBLC-RETURN-F-CBLC-USER-VALUE PIC S9(9).
       05 CBLC-RETURN-F-CONSUMED PIC S9(9).
       05 CBLC-RETURN-F-ERROR PIC S9(9).
       PROCEDURE DIVISION USING BY REFERENCE F-SOURCE
            BY REFERENCE F-SOURCE-LENGTH
            BY REFERENCE CBLC-RETURN-F.
       F.
           COMPUTE F-RESULT-CBLC-USER-VALUE = 0.
           COMPUTE F-RESULT-CONSUMED = 0.
           COMPUTE F-RESULT-ERROR = 0.
           COMPUTE F-INDEX = 0.
           COMPUTE F-NEGATIVE = 0.
           COMPUTE F-SEEN-DIGIT = 0.
           COMPUTE F-DIGIT-COUNT = 0.
           PERFORM UNTIL NOT (F-INDEX < F-SOURCE-LENGTH AND F-SOURCE-BUF(F-INDEX + 1:1) = ' ')
           COMPUTE F-INDEX = F-INDEX + 1
           END-PERFORM.
           IF F-INDEX < F-SOURCE-LENGTH AND F-SOURCE-BUF(F-INDEX + 1:1) = '-'
           COMPUTE F-NEGATIVE = 1
           COMPUTE F-INDEX = F-INDEX + 1
           ELSE
           IF F-INDEX < F-SOURCE-LENGTH AND F-SOURCE-BUF(F-INDEX + 1:1) = '+'
           COMPUTE F-INDEX = F-INDEX + 1
           END-IF
           END-IF.
           PERFORM UNTIL NOT (F-INDEX < F-SOURCE-LENGTH)
           MOVE F-SOURCE-BUF(F-INDEX + 1:1) TO F-CURRENT
           IF F-CURRENT >= '0' AND F-CURRENT <= '9'
           COMPUTE F-DIGIT = FUNCTION ORD(F-CURRENT) - FUNCTION ORD('0')
           COMPUTE F-RESULT-CBLC-USER-VALUE = F-RESULT-CBLC-USER-VALUE * 10 + F-DIGIT
           COMPUTE F-DIGIT-COUNT = F-DIGIT-COUNT + 1
           COMPUTE F-SEEN-DIGIT = 1
           COMPUTE F-INDEX = F-INDEX + 1
           ELSE
           IF F-CURRENT = ' '
           COMPUTE F-INDEX = F-SOURCE-LENGTH
           ELSE
           COMPUTE F-RESULT-ERROR = 3
           COMPUTE F-INDEX = F-SOURCE-LENGTH
           END-IF
           END-IF
           END-PERFORM.
           IF F-SEEN-DIGIT = 0
           COMPUTE F-RESULT-ERROR = 1
           END-IF.
           IF F-DIGIT-COUNT > 9
           COMPUTE F-RESULT-ERROR = 2
           COMPUTE F-RESULT-CBLC-USER-VALUE = 0
           END-IF.
           IF F-NEGATIVE = 1
           COMPUTE F-RESULT-CBLC-USER-VALUE = 0 - F-RESULT-CBLC-USER-VALUE
           END-IF.
           COMPUTE F-RESULT-CONSUMED = F-INDEX.
           MOVE F-RESULT TO CBLC-RETURN-F.
           GOBACK.
           GOBACK.

       END PROGRAM CBLC-PARSE-INT-RESULT.

