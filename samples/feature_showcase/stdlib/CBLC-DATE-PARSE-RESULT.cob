>>SOURCE FORMAT IS FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CBLC-DATE-PARSE-RESULT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 CBLC-RETURN-DATE-PARSE-FORMAT-OK PIC S9(9) COMP-5.
       01 DATE-PARSE-FORMAT-OK-INPUT USAGE POINTER VALUE NULL.
       01 DATE-PARSE-FORMAT-OK-INDEX PIC S9(9) COMP-5.
       01 DATE-PARSE-FORMAT-OK-RESULT PIC S9(9) COMP-5.
       01 DATE-PARSE-FORMAT-OK-CURRENT PIC X(1).
       01 CBLC-RETURN-DATE-PARSE-PACKED PIC S9(9) COMP-5.
       01 DATE-PARSE-PACKED-INPUT USAGE POINTER VALUE NULL.
       01 DATE-PARSE-PACKED-INDEX PIC S9(9) COMP-5.
       01 DATE-PARSE-PACKED-PACKED-RESULT PIC S9(9) COMP-5.
       01 DATE-PARSE-PACKED-CURRENT PIC X(1).
       01 F-RESULT.
       05 F-RESULT-YEAR PIC S9(9).
       05 F-RESULT-MONTH PIC S9(9).
       05 F-RESULT-DAY PIC S9(9).
       05 F-RESULT-PACKED PIC S9(9).
       05 F-RESULT-SERIAL PIC S9(9).
       05 F-RESULT-ERROR PIC S9(9).
       01 F-YEAR PIC S9(9) COMP-5.
       01 F-MONTH PIC S9(9) COMP-5.
       01 F-DAY PIC S9(9) COMP-5.
       01 F-PACKED PIC S9(9) COMP-5.
       01 F-SERIAL PIC S9(9) COMP-5.
       01 F-ERROR PIC S9(9) COMP-5.
       01 F-FORMAT-OK PIC S9(9) COMP-5.
       01 F-MONTH-BASE PIC S9(9) COMP-5.
       01 F-MAX-DAY PIC S9(9) COMP-5.
       01 F-LEAP-YEAR PIC S9(9) COMP-5.
       01 F-PREVIOUS-YEAR PIC S9(9) COMP-5.
       01 F-LEAP-COUNT PIC S9(9) COMP-5.
       01 CBLC-PTR-CURSOR USAGE POINTER VALUE NULL.
       01 CBLC-PTR-OFFSET PIC S9(9) VALUE 0.
       01 CBLC-PTR-CHAR BASED PIC X.
       01 CBLC-PTR-INT BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR BASED USAGE POINTER.
       01 CBLC-PTR-CHAR-2 BASED PIC X.
       01 CBLC-PTR-INT-2 BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR-2 BASED USAGE POINTER.
       LINKAGE SECTION.
       01 F-INPUT PIC X(255).
       01 CBLC-RETURN-F.
       05 CBLC-RETURN-F-YEAR PIC S9(9).
       05 CBLC-RETURN-F-MONTH PIC S9(9).
       05 CBLC-RETURN-F-DAY PIC S9(9).
       05 CBLC-RETURN-F-PACKED PIC S9(9).
       05 CBLC-RETURN-F-SERIAL PIC S9(9).
       05 CBLC-RETURN-F-ERROR PIC S9(9).
       PROCEDURE DIVISION USING BY REFERENCE F-INPUT
            BY REFERENCE CBLC-RETURN-F.
       F.
           SET DATE-PARSE-PACKED-INPUT TO F-INPUT.
           PERFORM DATE-PARSE-PACKED.
           MOVE CBLC-RETURN-DATE-PARSE-PACKED TO F-PACKED.
           SET DATE-PARSE-FORMAT-OK-INPUT TO F-INPUT.
           PERFORM DATE-PARSE-FORMAT-OK.
           MOVE CBLC-RETURN-DATE-PARSE-FORMAT-OK TO F-FORMAT-OK.
           COMPUTE F-YEAR = F-PACKED / 10000.
           COMPUTE F-MONTH-BASE = F-PACKED / 100.
           COMPUTE F-MONTH = F-MONTH-BASE - F-YEAR * 100.
           COMPUTE F-DAY = F-PACKED - F-MONTH-BASE * 100.
           COMPUTE F-SERIAL = 0.
           COMPUTE F-ERROR = 0.
           IF F-FORMAT-OK = 0
           COMPUTE F-ERROR = 1
           END-IF.
           COMPUTE F-MAX-DAY = 31.
           COMPUTE F-LEAP-YEAR = 0.
           IF F-YEAR / 4 * 4 = F-YEAR
           COMPUTE F-LEAP-YEAR = 1
           END-IF.
           IF F-YEAR / 100 * 100 = F-YEAR
           COMPUTE F-LEAP-YEAR = 0
           END-IF.
           IF F-YEAR / 400 * 400 = F-YEAR
           COMPUTE F-LEAP-YEAR = 1
           END-IF.
           IF F-MONTH = 4 OR F-MONTH = 6 OR F-MONTH = 9 OR F-MONTH = 11
           COMPUTE F-MAX-DAY = 30
           END-IF.
           IF F-MONTH = 2
           COMPUTE F-MAX-DAY = 28
           IF F-LEAP-YEAR = 1
           COMPUTE F-MAX-DAY = 29
           END-IF
           END-IF.
           IF F-MONTH < 1 OR F-MONTH > 12
           COMPUTE F-ERROR = 2
           END-IF.
           IF F-DAY < 1 OR F-DAY > F-MAX-DAY
           COMPUTE F-ERROR = 3
           END-IF.
           IF F-ERROR NOT = 0
           COMPUTE F-YEAR = 0
           COMPUTE F-MONTH = 0
           COMPUTE F-DAY = 0
           COMPUTE F-PACKED = 0
           COMPUTE F-SERIAL = 0
           END-IF.
           IF F-ERROR = 0
           COMPUTE F-PREVIOUS-YEAR = F-YEAR - 1
           COMPUTE F-SERIAL = F-YEAR - 1601
           COMPUTE F-SERIAL = F-SERIAL * 365
           COMPUTE F-LEAP-COUNT = F-PREVIOUS-YEAR / 4 - 400
           COMPUTE F-SERIAL = F-SERIAL + F-LEAP-COUNT
           COMPUTE F-LEAP-COUNT = F-PREVIOUS-YEAR / 100 - 16
           COMPUTE F-SERIAL = F-SERIAL - F-LEAP-COUNT
           COMPUTE F-LEAP-COUNT = F-PREVIOUS-YEAR / 400 - 4
           COMPUTE F-SERIAL = F-SERIAL + F-LEAP-COUNT
           COMPUTE F-SERIAL = F-SERIAL + F-DAY
           IF F-MONTH > 1
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 2
           COMPUTE F-SERIAL = F-SERIAL + 28
           END-IF
           IF F-MONTH > 2 AND F-LEAP-YEAR = 1
           COMPUTE F-SERIAL = F-SERIAL + 1
           END-IF
           IF F-MONTH > 3
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 4
           COMPUTE F-SERIAL = F-SERIAL + 30
           END-IF
           IF F-MONTH > 5
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 6
           COMPUTE F-SERIAL = F-SERIAL + 30
           END-IF
           IF F-MONTH > 7
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 8
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 9
           COMPUTE F-SERIAL = F-SERIAL + 30
           END-IF
           IF F-MONTH > 10
           COMPUTE F-SERIAL = F-SERIAL + 31
           END-IF
           IF F-MONTH > 11
           COMPUTE F-SERIAL = F-SERIAL + 30
           END-IF
           END-IF.
           COMPUTE F-RESULT-YEAR = F-YEAR.
           COMPUTE F-RESULT-MONTH = F-MONTH.
           COMPUTE F-RESULT-DAY = F-DAY.
           COMPUTE F-RESULT-PACKED = F-PACKED.
           COMPUTE F-RESULT-SERIAL = F-SERIAL.
           COMPUTE F-RESULT-ERROR = F-ERROR.
           MOVE F-RESULT TO CBLC-RETURN-F.
           GOBACK.
           GOBACK.

       DATE-PARSE-FORMAT-OK.
           COMPUTE DATE-PARSE-FORMAT-OK-INDEX = 0.
           COMPUTE DATE-PARSE-FORMAT-OK-RESULT = 1.
           PERFORM UNTIL NOT (DATE-PARSE-FORMAT-OK-INDEX < 8)
           MOVE DATE-PARSE-FORMAT-OK-INPUT(DATE-PARSE-FORMAT-OK-INDEX + 1:1) TO DATE-PARSE-FORMAT-OK-CURRENT
           IF DATE-PARSE-FORMAT-OK-CURRENT < '0' OR DATE-PARSE-FORMAT-OK-CURRENT > '9'
           COMPUTE DATE-PARSE-FORMAT-OK-RESULT = 0
           END-IF
           COMPUTE DATE-PARSE-FORMAT-OK-INDEX = DATE-PARSE-FORMAT-OK-INDEX + 1
           END-PERFORM.
           MOVE DATE-PARSE-FORMAT-OK-RESULT TO CBLC-RETURN-DATE-PARSE-FORMAT-OK.
           GOBACK.

       DATE-PARSE-PACKED.
           COMPUTE DATE-PARSE-PACKED-INDEX = 0.
           COMPUTE DATE-PARSE-PACKED-PACKED-RESULT = 0.
           PERFORM UNTIL NOT (DATE-PARSE-PACKED-INDEX < 8)
           MOVE DATE-PARSE-PACKED-INPUT(DATE-PARSE-FORMAT-OK-INDEX + 1:1) TO DATE-PARSE-PACKED-CURRENT
           COMPUTE DATE-PARSE-PACKED-PACKED-RESULT = DATE-PARSE-PACKED-PACKED-RESULT * 10 + FUNCTION ORD(DATE-PARSE-PACKED-CURRENT) - 48
           COMPUTE DATE-PARSE-PACKED-INDEX = DATE-PARSE-PACKED-INDEX + 1
           END-PERFORM.
           MOVE DATE-PARSE-PACKED-PACKED-RESULT TO CBLC-RETURN-DATE-PARSE-PACKED.
           GOBACK.

       END PROGRAM CBLC-DATE-PARSE-RESULT.

