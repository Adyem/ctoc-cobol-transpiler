import "message_showcase_constants.cblc";

struct Desk
{
    string name(16);
    int open_items;
    int closed_items;
};

struct Portfolio
{
    Desk underwriting;
    Desk claims;
};

Portfolio book;
int output_report_id;
int policies_total;
int claims_net;
int weighted_total;
int score_snapshot;
int loss_ratio;
int reserve_gap_amount;

char *ledger_marker_buffer;
char ledger_marker;

class Ledger
{
    private:
        const int identifier;
        string tag(16);
        int policy_count;
        int claim_count;
        int investigation_count;
        int paid_claims;
        int weight_seed;
        int weighted_score;

    public:
        Ledger(int id) : tag("BASE"), identifier(id)
        {
            policy_count = 0;
            claim_count = 0;
            investigation_count = 0;
            paid_claims = 0;
            weight_seed = 23;
            weighted_score = 0;
            ledger_marker_buffer = std::malloc(4);
            ledger_marker_buffer[0] = 'R';
            ledger_marker = ledger_marker_buffer[0];
        }

        ~Ledger()
        {
            std::free(ledger_marker_buffer);
        }

        void load(int policies, int claims, int investigations, int paid);
        void print_header();
};

void Ledger::load(int policies, int claims, int investigations, int paid)
{
    policy_count = policies;
    claim_count = claims;
    investigation_count = investigations;
    paid_claims = paid;
    weighted_score = policy_count / 250 + weight_seed - investigation_count;
    return;
}

void Ledger::print_header()
{
    display(tag);
    display("Memory marker");
    display(ledger_marker);
    return;
}

void showcase_portfolio()
{
    Ledger risk_review(3);
    book.underwriting.name = "UNDERWRITING";
    book.underwriting.open_items = 19;
    book.underwriting.closed_items = 23;
    book.claims.name = "CLAIMS";
    book.claims.open_items = 32;
    book.claims.closed_items = 27;
    risk_review.load(1250, 32, 5, 72000);
    risk_review.print_header();
    output_report_id = 3;
    policies_total = 1250;
    claims_net = 27;
    weighted_total = 23;
    loss_ratio = 15;
    reserve_gap_amount = 120000;
    weighted_total = weighted_total + 1;
    score_snapshot = weighted_total;
    display(book.underwriting.name);
    display(book.claims.name);
    display("Policies");
    display(policies_total);
    display("Net claims");
    display(claims_net);
    display("Weighted score");
    display(weighted_total);
    display("Score snapshot");
    display(score_snapshot);
    display("Loss ratio");
    display(loss_ratio);
    display("Reserve gap");
    display(reserve_gap_amount);
    display("Snapshot id");
    display(output_report_id);
    try
    {
        throw claims_net;
    }
    catch (int failed_investigations)
    {
        display("Claim batch rejected");
    }
    return;
}
