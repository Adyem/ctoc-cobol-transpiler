>>SOURCE FORMAT IS FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SHOWCASE-TEXT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 RESERVE-TARGET PIC S9(9) VALUE 600000.
       01 EARNED-PREMIUM PIC S9(9) VALUE 480000.
       01 TITLE.
          05 TITLE-LEN PIC 9(4) COMP VALUE 0.
          05 TITLE-CAP PIC 9(4) COMP VALUE 0.
          05 TITLE-PTR USAGE POINTER VALUE NULL.
       01 TITLE-BUF BASED PIC X(15).
       01 NOTE.
          05 NOTE-LEN PIC 9(4) COMP VALUE 0.
          05 NOTE-CAP PIC 9(4) COMP VALUE 0.
          05 NOTE-PTR USAGE POINTER VALUE NULL.
       01 NOTE-BUF BASED PIC X(17).
       01 SUFFIX.
          05 SUFFIX-LEN PIC 9(4) COMP VALUE 0.
          05 SUFFIX-CAP PIC 9(4) COMP VALUE 0.
          05 SUFFIX-PTR USAGE POINTER VALUE NULL.
       01 SUFFIX-BUF BASED PIC X(1).
       01 TITLE-LENGTH PIC S9(9).
       01 NOTE-LENGTH PIC S9(9).
       01 CBLC-HELPER-STATUS PIC S9(9).
       01 CBLC-INTRINSIC-TITLE-ARG0-GROUP.
          05 CBLC-INTRINSIC-TITLE-ARG0-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-TITLE-ARG0-BUF PIC X(256).
       01 CBLC-INTRINSIC-TITLE-ARG1-GROUP.
          05 CBLC-INTRINSIC-TITLE-ARG1-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-TITLE-ARG1-BUF PIC X(256).
       01 CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-TITLE-ARG2-STATUS PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-NOTE-ARG0-GROUP.
          05 CBLC-INTRINSIC-NOTE-ARG0-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-NOTE-ARG0-BUF PIC X(256).
       01 CBLC-INTRINSIC-NOTE-ARG1-GROUP.
          05 CBLC-INTRINSIC-NOTE-ARG1-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-NOTE-ARG1-BUF PIC X(256).
       01 CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-NOTE-ARG2-STATUS PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-SUFFIX-ARG0-GROUP.
          05 CBLC-INTRINSIC-SUFFIX-ARG0-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-SUFFIX-ARG0-BUF PIC X(256).
       01 CBLC-INTRINSIC-SUFFIX-ARG1-GROUP.
          05 CBLC-INTRINSIC-SUFFIX-ARG1-LEN PIC S9(9) COMP VALUE 0.
          05 CBLC-INTRINSIC-SUFFIX-ARG1-BUF PIC X(256).
       01 CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-SUFFIX-ARG2-STATUS PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-TITLE-LEN-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-TITLE-CAPACITY-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-TITLE-EMPTY-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-NOTE-LEN-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-NOTE-CAPACITY-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-NOTE-EMPTY-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-SUFFIX-LEN-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-SUFFIX-CAPACITY-RESULT PIC S9(9) VALUE 0.
       01 CBLC-INTRINSIC-SUFFIX-EMPTY-RESULT PIC S9(9) VALUE 0.
       PROCEDURE DIVISION.
       SHOWCASE-TEXT.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-CAP < 15
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               ALLOCATE 15 CHARACTERS RETURNING TITLE-PTR
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               COMPUTE TITLE-CAP = 15
           END-IF.
           MOVE "POLICY SNAPSHOT" TO TITLE-BUF.
           COMPUTE TITLE-LEN = 15.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-CAP < 16
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 16
           END-IF.
           MOVE SPACES TO NOTE-BUF.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-CAP < 1
               IF SUFFIX-PTR NOT = NULL
                   FREE SUFFIX-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING SUFFIX-PTR
               SET ADDRESS OF SUFFIX-BUF TO SUFFIX-PTR
               COMPUTE SUFFIX-CAP = 1
           END-IF.
           MOVE "!" TO SUFFIX-BUF.
           COMPUTE SUFFIX-LEN = 1.
           IF NOTE-CAP < 10
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 10 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 10
           END-IF.
           SET ADDRESS OF NOTE-BUF TO NOTE-PTR
           MOVE "clean base" TO NOTE-BUF.
           MOVE 10 TO NOTE-LEN.
           MOVE SUFFIX-BUF TO CBLC-INTRINSIC-NOTE-ARG1-BUF.
           COMPUTE CBLC-INTRINSIC-NOTE-ARG1-LEN = SUFFIX-LEN.
           PERFORM CBLC-INTRINSIC-NOTE-APPEND.
           IF TITLE-CAP < 1
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING TITLE-PTR
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               COMPUTE TITLE-CAP = 1
           END-IF.
           SET ADDRESS OF TITLE-BUF TO TITLE-PTR
           DISPLAY TITLE-BUF(1:TITLE-LEN).
           PERFORM CBLC-INTRINSIC-TITLE-LEN.
           COMPUTE TITLE-LENGTH = CBLC-INTRINSIC-TITLE-LEN-RESULT.
           DISPLAY "Title chars".
           DISPLAY TITLE-LENGTH.
           DISPLAY "String value".
           IF NOTE-CAP < 1
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 1
           END-IF.
           SET ADDRESS OF NOTE-BUF TO NOTE-PTR
           DISPLAY NOTE-BUF(1:NOTE-LEN).
           PERFORM CBLC-INTRINSIC-NOTE-LEN.
           COMPUTE NOTE-LENGTH = CBLC-INTRINSIC-NOTE-LEN-RESULT.
           DISPLAY "Note chars".
           DISPLAY NOTE-LENGTH.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-PTR NOT = NULL
               FREE SUFFIX-PTR
           END-IF.
           SET SUFFIX-PTR TO NULL.
           MOVE 0 TO SUFFIX-CAP.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-PTR NOT = NULL
               FREE NOTE-PTR
           END-IF.
           SET NOTE-PTR TO NULL.
           MOVE 0 TO NOTE-CAP.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-PTR NOT = NULL
               FREE TITLE-PTR
           END-IF.
           SET TITLE-PTR TO NULL.
           MOVE 0 TO TITLE-CAP.
           GOBACK.
       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

           GOBACK.

       CBLC-INTRINSIC-TITLE-LEN.
           COMPUTE CBLC-INTRINSIC-TITLE-LEN-RESULT = TITLE-LEN.
           EXIT.

       CBLC-INTRINSIC-TITLE-CAPACITY.
           COMPUTE CBLC-INTRINSIC-TITLE-CAPACITY-RESULT = 15.
           EXIT.

       CBLC-INTRINSIC-TITLE-EMPTY.
           COMPUTE CBLC-INTRINSIC-TITLE-EMPTY-RESULT = 0.
           IF TITLE-LEN = 0
               COMPUTE CBLC-INTRINSIC-TITLE-EMPTY-RESULT = 1
           END-IF.
           EXIT.

       CBLC-INTRINSIC-TITLE-CLEAR.
           MOVE SPACES TO TITLE-BUF.
           COMPUTE TITLE-LEN = 0.
           EXIT.

       CBLC-INTRINSIC-NOTE-LEN.
           COMPUTE CBLC-INTRINSIC-NOTE-LEN-RESULT = NOTE-LEN.
           EXIT.

       CBLC-INTRINSIC-NOTE-CAPACITY.
           COMPUTE CBLC-INTRINSIC-NOTE-CAPACITY-RESULT = 17.
           EXIT.

       CBLC-INTRINSIC-NOTE-EMPTY.
           COMPUTE CBLC-INTRINSIC-NOTE-EMPTY-RESULT = 0.
           IF NOTE-LEN = 0
               COMPUTE CBLC-INTRINSIC-NOTE-EMPTY-RESULT = 1
           END-IF.
           EXIT.

       CBLC-INTRINSIC-NOTE-CLEAR.
           MOVE SPACES TO NOTE-BUF.
           COMPUTE NOTE-LEN = 0.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-LEN.
           COMPUTE CBLC-INTRINSIC-SUFFIX-LEN-RESULT = SUFFIX-LEN.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-CAPACITY.
           COMPUTE CBLC-INTRINSIC-SUFFIX-CAPACITY-RESULT = 1.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-EMPTY.
           COMPUTE CBLC-INTRINSIC-SUFFIX-EMPTY-RESULT = 0.
           IF SUFFIX-LEN = 0
               COMPUTE CBLC-INTRINSIC-SUFFIX-EMPTY-RESULT = 1
           END-IF.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-CLEAR.
           MOVE SPACES TO SUFFIX-BUF.
           COMPUTE SUFFIX-LEN = 0.
           EXIT.

       CBLC-INTRINSIC-TITLE-APPEND.
           MOVE 0 TO CBLC-INTRINSIC-TITLE-ARG2-STATUS.
           IF TITLE-CAP < TITLE-LEN + CBLC-INTRINSIC-TITLE-ARG1-LEN
               MOVE SPACES TO CBLC-INTRINSIC-TITLE-ARG0-BUF
               IF TITLE-LEN > 0
                   MOVE TITLE-BUF(1:TITLE-LEN)  TO CBLC-INTRINSIC-TITLE-ARG0-BUF(1:TITLE-LEN)
               END-IF
               MOVE TITLE-LEN TO CBLC-INTRINSIC-TITLE-ARG0-LEN
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               IF TITLE-LEN + CBLC-INTRINSIC-TITLE-ARG1-LEN > 15
                   ALLOCATE TITLE-LEN + CBLC-INTRINSIC-TITLE-ARG1-LEN CHARACTERS RETURNING TITLE-PTR
                   COMPUTE TITLE-CAP = TITLE-LEN + CBLC-INTRINSIC-TITLE-ARG1-LEN
               ELSE
                   ALLOCATE 15 CHARACTERS RETURNING TITLE-PTR
                   MOVE 15 TO TITLE-CAP
               END-IF
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               IF CBLC-INTRINSIC-TITLE-ARG0-LEN > 0
                   MOVE CBLC-INTRINSIC-TITLE-ARG0-BUF(1:CBLC-INTRINSIC-TITLE-ARG0-LEN)  TO TITLE-BUF(1:CBLC-INTRINSIC-TITLE-ARG0-LEN)
               END-IF
           END-IF
           IF CBLC-INTRINSIC-TITLE-ARG1-LEN > 0
               MOVE CBLC-INTRINSIC-TITLE-ARG1-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN)  TO TITLE-BUF(TITLE-LEN + 1:CBLC-INTRINSIC-TITLE-ARG1-LEN)
           END-IF
           COMPUTE TITLE-LEN = TITLE-LEN + CBLC-INTRINSIC-TITLE-ARG1-LEN.
           EXIT.

       CBLC-INTRINSIC-TITLE-EQUALS.
           MOVE 0 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT.
           IF TITLE-LEN = CBLC-INTRINSIC-TITLE-ARG1-LEN
               IF TITLE-LEN = 0
                   MOVE 1 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
               ELSE
                   IF TITLE-BUF(1:TITLE-LEN) = CBLC-INTRINSIC-TITLE-ARG1-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-TITLE-STARTS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-TITLE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
           ELSE
               IF TITLE-LEN >= CBLC-INTRINSIC-TITLE-ARG1-LEN
                   IF TITLE-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN) = CBLC-INTRINSIC-TITLE-ARG1-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-TITLE-ENDS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-TITLE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
           ELSE
               IF TITLE-LEN >= CBLC-INTRINSIC-TITLE-ARG1-LEN
                   IF TITLE-BUF(TITLE-LEN - CBLC-INTRINSIC-TITLE-ARG1-LEN + 1:CBLC-INTRINSIC-TITLE-ARG1-LEN) = CBLC-INTRINSIC-TITLE-ARG1-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-TITLE-COMPARE.
           CALL 'CBLC-STRCMP-STRING' USING BY REFERENCE TITLE BY REFERENCE CBLC-INTRINSIC-TITLE-ARG1-GROUP BY REFERENCE CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT.
           EXIT.

       CBLC-INTRINSIC-TITLE-CONTAINS.
           MOVE 0 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-TITLE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
           ELSE
               INSPECT TITLE-BUF(1:TITLE-LEN) TALLYING CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT FOR ALL CBLC-INTRINSIC-TITLE-ARG1-BUF(1:CBLC-INTRINSIC-TITLE-ARG1-LEN)
               IF CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT > 0
                   MOVE 1 TO CBLC-INTRINSIC-TITLE-PARAMETERIZED-RESULT
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-NOTE-APPEND.
           MOVE 0 TO CBLC-INTRINSIC-NOTE-ARG2-STATUS.
           IF NOTE-CAP < NOTE-LEN + CBLC-INTRINSIC-NOTE-ARG1-LEN
               MOVE SPACES TO CBLC-INTRINSIC-NOTE-ARG0-BUF
               IF NOTE-LEN > 0
                   MOVE NOTE-BUF(1:NOTE-LEN)  TO CBLC-INTRINSIC-NOTE-ARG0-BUF(1:NOTE-LEN)
               END-IF
               MOVE NOTE-LEN TO CBLC-INTRINSIC-NOTE-ARG0-LEN
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               IF NOTE-LEN + CBLC-INTRINSIC-NOTE-ARG1-LEN > 17
                   ALLOCATE NOTE-LEN + CBLC-INTRINSIC-NOTE-ARG1-LEN CHARACTERS RETURNING NOTE-PTR
                   COMPUTE NOTE-CAP = NOTE-LEN + CBLC-INTRINSIC-NOTE-ARG1-LEN
               ELSE
                   ALLOCATE 17 CHARACTERS RETURNING NOTE-PTR
                   MOVE 17 TO NOTE-CAP
               END-IF
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               IF CBLC-INTRINSIC-NOTE-ARG0-LEN > 0
                   MOVE CBLC-INTRINSIC-NOTE-ARG0-BUF(1:CBLC-INTRINSIC-NOTE-ARG0-LEN)  TO NOTE-BUF(1:CBLC-INTRINSIC-NOTE-ARG0-LEN)
               END-IF
           END-IF
           IF CBLC-INTRINSIC-NOTE-ARG1-LEN > 0
               MOVE CBLC-INTRINSIC-NOTE-ARG1-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN)  TO NOTE-BUF(NOTE-LEN + 1:CBLC-INTRINSIC-NOTE-ARG1-LEN)
           END-IF
           COMPUTE NOTE-LEN = NOTE-LEN + CBLC-INTRINSIC-NOTE-ARG1-LEN.
           EXIT.

       CBLC-INTRINSIC-NOTE-EQUALS.
           MOVE 0 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT.
           IF NOTE-LEN = CBLC-INTRINSIC-NOTE-ARG1-LEN
               IF NOTE-LEN = 0
                   MOVE 1 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
               ELSE
                   IF NOTE-BUF(1:NOTE-LEN) = CBLC-INTRINSIC-NOTE-ARG1-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-NOTE-STARTS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-NOTE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
           ELSE
               IF NOTE-LEN >= CBLC-INTRINSIC-NOTE-ARG1-LEN
                   IF NOTE-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN) = CBLC-INTRINSIC-NOTE-ARG1-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-NOTE-ENDS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-NOTE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
           ELSE
               IF NOTE-LEN >= CBLC-INTRINSIC-NOTE-ARG1-LEN
                   IF NOTE-BUF(NOTE-LEN - CBLC-INTRINSIC-NOTE-ARG1-LEN + 1:CBLC-INTRINSIC-NOTE-ARG1-LEN) = CBLC-INTRINSIC-NOTE-ARG1-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-NOTE-COMPARE.
           CALL 'CBLC-STRCMP-STRING' USING BY REFERENCE NOTE BY REFERENCE CBLC-INTRINSIC-NOTE-ARG1-GROUP BY REFERENCE CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT.
           EXIT.

       CBLC-INTRINSIC-NOTE-CONTAINS.
           MOVE 0 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-NOTE-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
           ELSE
               INSPECT NOTE-BUF(1:NOTE-LEN) TALLYING CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT FOR ALL CBLC-INTRINSIC-NOTE-ARG1-BUF(1:CBLC-INTRINSIC-NOTE-ARG1-LEN)
               IF CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT > 0
                   MOVE 1 TO CBLC-INTRINSIC-NOTE-PARAMETERIZED-RESULT
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-APPEND.
           MOVE 0 TO CBLC-INTRINSIC-SUFFIX-ARG2-STATUS.
           IF SUFFIX-CAP < SUFFIX-LEN + CBLC-INTRINSIC-SUFFIX-ARG1-LEN
               MOVE SPACES TO CBLC-INTRINSIC-SUFFIX-ARG0-BUF
               IF SUFFIX-LEN > 0
                   MOVE SUFFIX-BUF(1:SUFFIX-LEN)  TO CBLC-INTRINSIC-SUFFIX-ARG0-BUF(1:SUFFIX-LEN)
               END-IF
               MOVE SUFFIX-LEN TO CBLC-INTRINSIC-SUFFIX-ARG0-LEN
               IF SUFFIX-PTR NOT = NULL
                   FREE SUFFIX-PTR
               END-IF
               IF SUFFIX-LEN + CBLC-INTRINSIC-SUFFIX-ARG1-LEN > 1
                   ALLOCATE SUFFIX-LEN + CBLC-INTRINSIC-SUFFIX-ARG1-LEN CHARACTERS RETURNING SUFFIX-PTR
                   COMPUTE SUFFIX-CAP = SUFFIX-LEN + CBLC-INTRINSIC-SUFFIX-ARG1-LEN
               ELSE
                   ALLOCATE 1 CHARACTERS RETURNING SUFFIX-PTR
                   MOVE 1 TO SUFFIX-CAP
               END-IF
               SET ADDRESS OF SUFFIX-BUF TO SUFFIX-PTR
               IF CBLC-INTRINSIC-SUFFIX-ARG0-LEN > 0
                   MOVE CBLC-INTRINSIC-SUFFIX-ARG0-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG0-LEN)  TO SUFFIX-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG0-LEN)
               END-IF
           END-IF
           IF CBLC-INTRINSIC-SUFFIX-ARG1-LEN > 0
               MOVE CBLC-INTRINSIC-SUFFIX-ARG1-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)  TO SUFFIX-BUF(SUFFIX-LEN + 1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)
           END-IF
           COMPUTE SUFFIX-LEN = SUFFIX-LEN + CBLC-INTRINSIC-SUFFIX-ARG1-LEN.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-EQUALS.
           MOVE 0 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT.
           IF SUFFIX-LEN = CBLC-INTRINSIC-SUFFIX-ARG1-LEN
               IF SUFFIX-LEN = 0
                   MOVE 1 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
               ELSE
                   IF SUFFIX-BUF(1:SUFFIX-LEN) = CBLC-INTRINSIC-SUFFIX-ARG1-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-STARTS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-SUFFIX-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
           ELSE
               IF SUFFIX-LEN >= CBLC-INTRINSIC-SUFFIX-ARG1-LEN
                   IF SUFFIX-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN) = CBLC-INTRINSIC-SUFFIX-ARG1-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-ENDS-WITH.
           MOVE 0 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-SUFFIX-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
           ELSE
               IF SUFFIX-LEN >= CBLC-INTRINSIC-SUFFIX-ARG1-LEN
                   IF SUFFIX-BUF(SUFFIX-LEN - CBLC-INTRINSIC-SUFFIX-ARG1-LEN + 1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN) = CBLC-INTRINSIC-SUFFIX-ARG1-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)
                       MOVE 1  TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
                   END-IF
               END-IF
           END-IF.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-COMPARE.
           CALL 'CBLC-STRCMP-STRING' USING BY REFERENCE SUFFIX BY REFERENCE CBLC-INTRINSIC-SUFFIX-ARG1-GROUP BY REFERENCE CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT.
           EXIT.

       CBLC-INTRINSIC-SUFFIX-CONTAINS.
           MOVE 0 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT.
           IF CBLC-INTRINSIC-SUFFIX-ARG1-LEN = 0
               MOVE 1 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
           ELSE
               INSPECT SUFFIX-BUF(1:SUFFIX-LEN) TALLYING CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT FOR ALL CBLC-INTRINSIC-SUFFIX-ARG1-BUF(1:CBLC-INTRINSIC-SUFFIX-ARG1-LEN)
               IF CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT > 0
                   MOVE 1 TO CBLC-INTRINSIC-SUFFIX-PARAMETERIZED-RESULT
               END-IF
           END-IF.
           EXIT.

       END PROGRAM SHOWCASE-TEXT.

