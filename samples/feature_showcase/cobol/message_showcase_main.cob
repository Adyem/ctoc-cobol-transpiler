       01 SCRATCH USAGE POINTER VALUE NULL.
       01 CBLC-HELPER-STATUS PIC S9(9).
       01 MODULE-COUNT PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE.
       05 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE-CBLC-USER-DATA USAGE POINTER VALUE NULL.
       05 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE-RELOCATION 
      -    USAGE POINTER VALUE NULL.
       05 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE-COUNT PIC S9(9).
       05 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE-RESERVED PIC S9(9).
       05 CBLC-TPL-VECTOR-INT-OPERATOR-ASSIGN-SOURCE-RELOCATION-INDEX PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-PUSH-BACK-VALUE PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-AT-INDEX PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-EMPLACE-BACK-VALUE PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-INSERT-INDEX PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-INSERT-VALUE PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-ERASE-INDEX PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-ASSIGN-VALUE PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED PIC S9(9).
       01 CBLC-TPL-VECTOR-INT-CTOR-SOURCE.
