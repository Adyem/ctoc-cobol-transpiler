       01 CBLC-PTR-INT-PTR-2 BASED USAGE POINTER.
       PROCEDURE DIVISION.
       MAIN.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-CAP < 16
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING 
      -    BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-CAP < 16
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  
      -    TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-CLAIMS-NAME-BUF.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           PERFORM CBLC-CONSTRUCTOR-SCORE-HISTORY-0.
           COMPUTE MODULE-COUNT = 3.
           DISPLAY "CBL-C STARTER SHOWCASE".
           CALL 'SHOWCASE-TEXT'.
           PERFORM SHOWCASE-VECTOR.
           CALL 'SHOWCASE-PORTFOLIO'.
           CALL 'SHOWCASE-MEMORY'.
           DISPLAY "Modules".
           DISPLAY MODULE-COUNT.
           DISPLAY "SHOWCASE READY".
           PERFORM CBLC-DESTRUCTOR-SCORE-HISTORY.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
               FREE BOOK-UNDERWRITING-NAME-PTR
           END-IF.
           SET BOOK-UNDERWRITING-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-CAP.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-PTR NOT = NULL
               FREE BOOK-CLAIMS-NAME-PTR
           END-IF.
           SET BOOK-CLAIMS-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-CLAIMS-NAME-CAP.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           STOP RUN.
       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

           STOP RUN.

       SHOWCASE-VECTOR.
           COMPUTE CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED = 4.
           PERFORM 
      -    CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-RESERVE.
           COMPUTE CBLC-TPL-VECTOR-INT-PUSH-BACK-VALUE = 72.
           PERFORM 
      -    CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-PUSH-BACK.
           COMPUTE CBLC-TPL-VECTOR-INT-EMPLACE-BACK-VALUE = 86.
           PERFORM 
      -    CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-EMPLACE-BACK.
           COMPUTE CBLC-TPL-VECTOR-INT-INSERT-INDEX = 1.
           COMPUTE CBLC-TPL-VECTOR-INT-INSERT-VALUE = 94.
           PERFORM CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-INSERT.
           PERFORM CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SIZE.
           COMPUTE VECTOR-SIZE = 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SIZE.
           PERFORM CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-FRONT.
           COMPUTE VECTOR-FIRST = 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-FRONT.
           PERFORM CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-BACK.
           COMPUTE VECTOR-LAST = 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-BACK.
           DISPLAY "Vector size".
           DISPLAY VECTOR-SIZE.
           DISPLAY "Vector first".
           DISPLAY VECTOR-FIRST.
           DISPLAY "Vector last".
           DISPLAY VECTOR-LAST.
           GOBACK.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SIZE.
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SIZE = SCORE-HISTORY-COUNT.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-CAPACITY.
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-CAPACITY = SCORE-HISTORY-RESERVED.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-MAX-SIZE.
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-MAX-SIZE = 2147483647.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-EMPTY.
           IF SCORE-HISTORY-COUNT = 0
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-EMPTY = 1.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-RESERVE.
           IF CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED > 
      -    SCORE-HISTORY-RESERVED AND CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED > 0
           ALLOCATE CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED * 4 
      -    CHARACTERS RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 
      -    CBLC-TPL-VECTOR-INT-RESERVE-REQUESTED.
           END-IF.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SHRINK-TO-FIT.
           IF SCORE-HISTORY-COUNT < SCORE-HISTORY-RESERVED
           IF SCORE-HISTORY-COUNT = 0
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 0.
           ELSE
           ALLOCATE SCORE-HISTORY-COUNT * 4 CHARACTERS RETURNING 
      -    SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = SCORE-HISTORY-COUNT.
           END-IF
           END-IF.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-PUSH-BACK.
           IF SCORE-HISTORY-COUNT >= SCORE-HISTORY-RESERVED
           IF SCORE-HISTORY-RESERVED < 1
           ALLOCATE 1 * 4 CHARACTERS RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 1.
           ELSE
           ALLOCATE SCORE-HISTORY-RESERVED * 2 * 4 CHARACTERS 
      -    RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = SCORE-HISTORY-RESERVED * 2.
           END-IF
           END-IF.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-COUNT * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           MOVE CBLC-TPL-VECTOR-INT-PUSH-BACK-VALUE TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT + 1.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-POP-BACK.
           IF SCORE-HISTORY-COUNT > 0
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT - 1.
           END-IF.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-AT.
           IF CBLC-TPL-VECTOR-INT-AT-INDEX < 0 OR 
      -    CBLC-TPL-VECTOR-INT-AT-INDEX >= SCORE-HISTORY-COUNT
           COMPUTE VECTOR-AT-ERROR-CODE = 1
           IF CBLC-EX-RAISING = 'Y' OR CBLC-EX-CLEANING = 'Y'
               MOVE 76080172 TO CBLC-EX-SECONDARY-TYPE-ID
               MOVE 225 TO CBLC-EX-SECONDARY-SOURCE-LINE
               MOVE 13 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
               PERFORM CBLC-TERMINATE
           END-IF
           MOVE 'Y' TO CBLC-EX-RAISING
           MOVE VECTOR-AT-ERROR TO CBLC-EX-PAYLOAD-OUT-OF-RANGE
           MOVE 4 TO CBLC-EX-PAYLOAD-SIZE
           MOVE 76080172 TO CBLC-EX-TYPE-ID
           MOVE 76080172 TO CBLC-EX-DYNAMIC-TYPE-ID
           MOVE 225 TO CBLC-EX-SOURCE-LINE
           MOVE 3076006230 TO CBLC-EX-SOURCE-FILE-ID
           MOVE 13 TO CBLC-EX-SOURCE-COLUMN
           MOVE 'Y' TO CBLC-EX-PAYLOAD-OWNER
           MOVE 'Y' TO CBLC-EX-ACTIVE
           MOVE 'N' TO CBLC-EX-RAISING
           GOBACK
           END-IF.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = CBLC-TPL-VECTOR-INT-AT-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT  
      -    TO CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-AT.
           GOBACK.

           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-FRONT.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-FRONT = CBLC-PTR-INT.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-BACK.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-COUNT - 1 * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           COMPUTE 
      -    CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-BACK = CBLC-PTR-INT.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-EMPLACE-BACK.
           IF SCORE-HISTORY-COUNT >= SCORE-HISTORY-RESERVED
           IF SCORE-HISTORY-RESERVED < 1
           ALLOCATE 1 * 4 CHARACTERS RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 1.
           ELSE
           ALLOCATE SCORE-HISTORY-RESERVED * 2 * 4 CHARACTERS 
      -    RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = SCORE-HISTORY-RESERVED * 2.
           END-IF
           END-IF.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-COUNT * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           MOVE CBLC-TPL-VECTOR-INT-EMPLACE-BACK-VALUE TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT + 1.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-INSERT.
           IF CBLC-TPL-VECTOR-INT-INSERT-INDEX < 0
           COMPUTE CBLC-TPL-VECTOR-INT-INSERT-INDEX = 0.
           END-IF.
           IF CBLC-TPL-VECTOR-INT-INSERT-INDEX > SCORE-HISTORY-COUNT
           COMPUTE CBLC-TPL-VECTOR-INT-INSERT-INDEX = 
      -    SCORE-HISTORY-COUNT.
           END-IF.
           IF SCORE-HISTORY-COUNT >= SCORE-HISTORY-RESERVED
           IF SCORE-HISTORY-RESERVED < 1
           ALLOCATE 1 * 4 CHARACTERS RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 1.
           ELSE
           ALLOCATE SCORE-HISTORY-RESERVED * 2 * 4 CHARACTERS 
      -    RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = SCORE-HISTORY-RESERVED * 2.
           END-IF
           END-IF.
           COMPUTE VECTOR-INSERT-SHIFT = SCORE-HISTORY-COUNT.
           PERFORM UNTIL NOT (VECTOR-INSERT-SHIFT > 
      -    CBLC-TPL-VECTOR-INT-INSERT-INDEX)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = VECTOR-INSERT-SHIFT * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = VECTOR-INSERT-SHIFT - 1 * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE VECTOR-INSERT-SHIFT = VECTOR-INSERT-SHIFT - 1.
           END-PERFORM.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = VECTOR-AT-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           MOVE CBLC-TPL-VECTOR-INT-INSERT-VALUE TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT + 1.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-ERASE.
           IF CBLC-TPL-VECTOR-INT-ERASE-INDEX >= 0 AND 
      -    CBLC-TPL-VECTOR-INT-ERASE-INDEX < SCORE-HISTORY-COUNT
           COMPUTE VECTOR-ERASE-SHIFT = CBLC-TPL-VECTOR-INT-ERASE-INDEX.
           PERFORM UNTIL NOT (VECTOR-ERASE-SHIFT < 
      -    SCORE-HISTORY-COUNT - 1)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = VECTOR-ERASE-SHIFT * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = VECTOR-ERASE-SHIFT + 1 * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE VECTOR-ERASE-SHIFT = VECTOR-ERASE-SHIFT + 1.
           END-PERFORM
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT - 1.
           END-IF.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-CLEAR.
           COMPUTE SCORE-HISTORY-COUNT = 0.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-ASSIGN.
           IF CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED < 0
           COMPUTE CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED = 0.
           END-IF.
           IF CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED > 
      -    SCORE-HISTORY-RESERVED
           IF SCORE-HISTORY-CBLC-USER-DATA NOT = CBLC-USER-NULL
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           END-IF
           ALLOCATE CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED * 4 
      -    CHARACTERS RETURNING SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 
      -    CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED.
           END-IF.
           COMPUTE SCORE-HISTORY-COUNT = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-COUNT < 
      -    CBLC-TPL-VECTOR-INT-ASSIGN-REQUESTED)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-COUNT * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           MOVE CBLC-TPL-VECTOR-INT-ASSIGN-VALUE TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-COUNT = SCORE-HISTORY-COUNT + 1.
           END-PERFORM.
           EXIT.

       CBLC-METHOD-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-RESIZE.
           IF CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED < 0
           COMPUTE CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED = 0.
           END-IF.
           IF CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED > 
      -    SCORE-HISTORY-RESERVED
           ALLOCATE CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED * 4 
      -    CHARACTERS RETURNING SCORE-HISTORY-RELOCATION.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           PERFORM UNTIL NOT (SCORE-HISTORY-RELOCATION-INDEX < 
      -    SCORE-HISTORY-COUNT)
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-RELOCATION.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT TO CBLC-PTR-CURSOR.
           SET CBLC-PTR-CURSOR TO SCORE-HISTORY-CBLC-USER-DATA.
           COMPUTE CBLC-PTR-OFFSET = SCORE-HISTORY-RELOCATION-INDEX * 4.
           SET CBLC-PTR-CURSOR UP BY CBLC-PTR-OFFSET.
           SET ADDRESS OF CBLC-PTR-INT-2 TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-INT-2 TO CBLC-PTR-INT.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 
      -    SCORE-HISTORY-RELOCATION-INDEX + 1.
           END-PERFORM
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-CBLC-USER-DATA TO SCORE-HISTORY-RELOCATION.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-RESERVED = 
      -    CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED.
           END-IF.
           COMPUTE SCORE-HISTORY-COUNT = 
      -    CBLC-TPL-VECTOR-INT-RESIZE-REQUESTED.
           EXIT.

       CBLC-CONSTRUCTOR-SCORE-HISTORY-0.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           SET SCORE-HISTORY-RELOCATION TO NULL.
           COMPUTE SCORE-HISTORY-COUNT = 0.
           COMPUTE SCORE-HISTORY-RESERVED = 0.
           COMPUTE SCORE-HISTORY-RELOCATION-INDEX = 0.
           EXIT.

       CBLC-DESTRUCTOR-SCORE-HISTORY.
           FREE SCORE-HISTORY-CBLC-USER-DATA.
           SET SCORE-HISTORY-CBLC-USER-DATA TO NULL.
           EXIT.

       CBLC-TERMINATE.
           DISPLAY "Fatal CBL-C double exception"
           DISPLAY "Original exception type: " CBLC-EX-TYPE-ID
           DISPLAY "Original exception file ID: " CBLC-EX-SOURCE-FILE-ID
           DISPLAY "Original exception line: " CBLC-EX-SOURCE-LINE
           DISPLAY "Original exception column: " CBLC-EX-SOURCE-COLUMN
           DISPLAY "Secondary exception type: " 
      -    CBLC-EX-SECONDARY-TYPE-ID
           DISPLAY "Secondary exception line: " 
      -    CBLC-EX-SECONDARY-SOURCE-LINE
           DISPLAY "Secondary exception column: " 
      -    CBLC-EX-SECONDARY-SOURCE-COLUMN
           STOP RUN.

       END PROGRAM MAIN.

