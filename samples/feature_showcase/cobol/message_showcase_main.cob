       01 SCORE-HISTORY.
       05 SCORE-HISTORY-CBLC-USER-DATA USAGE POINTER VALUE NULL.
       05 SCORE-HISTORY-RELOCATION USAGE POINTER VALUE NULL.
       05 SCORE-HISTORY-COUNT PIC S9(9).
       05 SCORE-HISTORY-RESERVED PIC S9(9).
       05 SCORE-HISTORY-RELOCATION-INDEX PIC S9(9).
       01 VECTOR-SIZE PIC S9(9).
       01 VECTOR-FIRST PIC S9(9).
       01 VECTOR-LAST PIC S9(9).
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-SIZE PIC 
      -    S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-CAPACITY 
      -    PIC S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-MAX-SIZE 
      -    PIC S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-EMPTY PIC 
      -    S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-AT PIC 
      -    S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-FRONT PIC 
      -    S9(9) VALUE 0.
       01 CBLC-RESULT-SCORE-HISTORY-CBLC-TPL-VECTOR-INT-BACK PIC 
      -    S9(9) VALUE 0.
