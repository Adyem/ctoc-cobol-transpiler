>>SOURCE FORMAT IS FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. MAIN.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 CBLC-EX-CONTEXT.
          05 CBLC-EX-ACTIVE PIC X VALUE 'N'.
          05 CBLC-EX-MATCHED PIC X VALUE 'N'.
          05 CBLC-EX-TYPE-ID PIC 9(10) COMP-5 VALUE 0.
          05 CBLC-EX-DYNAMIC-TYPE-ID PIC 9(10) COMP-5 VALUE 0.
          05 CBLC-EX-PAYLOAD-SIZE PIC 9(9) COMP-5 VALUE 0.
          05 CBLC-EX-PAYLOAD-OWNER PIC X VALUE 'N'.
          05 CBLC-EX-SOURCE-FILE-ID PIC 9(10) COMP-5 VALUE 0.
          05 CBLC-EX-SOURCE-LINE PIC 9(9) COMP-5 VALUE 0.
          05 CBLC-EX-SOURCE-COLUMN PIC 9(9) COMP-5 VALUE 0.
          05 CBLC-EX-RAISING PIC X VALUE 'N'.
          05 CBLC-EX-CLEANING PIC X VALUE 'N'.
          05 CBLC-EX-SECONDARY-TYPE-ID PIC 9(10) COMP-5 VALUE 0.
          05 CBLC-EX-SECONDARY-SOURCE-LINE PIC 9(9) COMP-5 VALUE 0.
          05 CBLC-EX-SECONDARY-SOURCE-COLUMN PIC 9(9) COMP-5 VALUE 0.
          05 CBLC-EX-INT-PAYLOAD PIC S9(9) VALUE 0.
          05 CBLC-EX-STRING.
             10 CBLC-EX-STRING-LEN PIC 9(4) COMP VALUE 0.
             10 CBLC-EX-STRING-BUF PIC X(256).
       01 LEDGER-LOAD-POLICIES PIC S9(9).
       01 LEDGER-LOAD-CLAIMS PIC S9(9).
       01 LEDGER-LOAD-INVESTIGATIONS PIC S9(9).
       01 LEDGER-LOAD-PAID PIC S9(9).
       01 LEDGER-CTOR-ID PIC S9(9).
       01 BOOK.
       05 BOOK-UNDERWRITING.
       10 BOOK-UNDERWRITING-NAME.
       15 BOOK-UNDERWRITING-NAME-LEN PIC 9(4) COMP VALUE 0.
       15 BOOK-UNDERWRITING-NAME-CAP PIC 9(4) COMP VALUE 0.
       15 BOOK-UNDERWRITING-NAME-PTR USAGE POINTER VALUE NULL.
       10 BOOK-UNDERWRITING-OPEN-ITEMS PIC S9(9).
       10 BOOK-UNDERWRITING-CLOSED-ITEMS PIC S9(9).
       05 BOOK-CLAIMS.
       10 BOOK-CLAIMS-NAME.
       15 BOOK-CLAIMS-NAME-LEN PIC 9(4) COMP VALUE 0.
       15 BOOK-CLAIMS-NAME-CAP PIC 9(4) COMP VALUE 0.
       15 BOOK-CLAIMS-NAME-PTR USAGE POINTER VALUE NULL.
       10 BOOK-CLAIMS-OPEN-ITEMS PIC S9(9).
       10 BOOK-CLAIMS-CLOSED-ITEMS PIC S9(9).
       01 BOOK-UNDERWRITING-NAME-BUF BASED PIC X(16).
       01 BOOK-CLAIMS-NAME-BUF BASED PIC X(16).
       01 OUTPUT-REPORT-ID PIC S9(9).
       01 POLICIES-TOTAL PIC S9(9).
       01 CLAIMS-NET PIC S9(9).
       01 WEIGHTED-TOTAL PIC S9(9).
       01 SCORE-SNAPSHOT PIC S9(9).
       01 LOSS-RATIO PIC S9(9).
       01 RESERVE-GAP-AMOUNT PIC S9(9).
       01 LEDGER-MARKER-BUFFER USAGE POINTER VALUE NULL.
       01 LEDGER-MARKER PIC X(1).
       01 SCORES PIC S9(9) OCCURS 2 TIMES.
       01 SLOT PIC S9(9).
       01 SELECTED-SCORE PIC S9(9).
       01 COPIED-SCORE PIC S9(9).
       01 MARKER-BUFFER USAGE POINTER VALUE NULL.
       01 MARKER PIC X(1).
       01 SCRATCH USAGE POINTER VALUE NULL.
       01 CBLC-HELPER-STATUS PIC S9(9).
       01 MODULE-COUNT PIC S9(9).
       01 MODULE-DELTA PIC S9(9).
       01 PORTFOLIO-FAILURE PIC S9(9).
       01 CBLC-PTR-CURSOR USAGE POINTER VALUE NULL.
       01 CBLC-PTR-OFFSET PIC S9(9) VALUE 0.
       01 CBLC-PTR-CHAR BASED PIC X.
       01 CBLC-PTR-INT BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR BASED USAGE POINTER.
       01 CBLC-PTR-CHAR-2 BASED PIC X.
       01 CBLC-PTR-INT-2 BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR-2 BASED USAGE POINTER.
       PROCEDURE DIVISION.
       MAIN.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-CAP < 16
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-CAP < 16
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-CLAIMS-NAME-BUF.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           COMPUTE MODULE-COUNT = 3.
           COMPUTE MODULE-DELTA = 1.
           DISPLAY "CBL-C STARTER SHOWCASE".
           CALL 'SHOWCASE-TEXT'
               ON EXCEPTION
                   IF CBLC-EX-ACTIVE = 'Y' OR CBLC-EX-RAISING = 'Y' OR CBLC-EX-CLEANING = 'Y'
                       MOVE 874186721 TO CBLC-EX-SECONDARY-TYPE-ID
                       MOVE 14 TO CBLC-EX-SECONDARY-SOURCE-LINE
                       MOVE 5 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
                       PERFORM CBLC-TERMINATE
                   END-IF
                   MOVE 1 TO CBLC-EX-INT-PAYLOAD
                   MOVE 4 TO CBLC-EX-PAYLOAD-SIZE
                   MOVE 874186721 TO CBLC-EX-TYPE-ID
                   MOVE 874186721 TO CBLC-EX-DYNAMIC-TYPE-ID
                   MOVE 'Y' TO CBLC-EX-PAYLOAD-OWNER
                   MOVE 'Y' TO CBLC-EX-ACTIVE
           END-CALL.
           IF CBLC-EX-ACTIVE = 'Y'
               STOP RUN
           END-IF.
           MOVE 'N' TO CBLC-EX-ACTIVE.
           MOVE 'N' TO CBLC-EX-MATCHED.
           CALL 'SHOWCASE-PORTFOLIO' USING BY REFERENCE CBLC-EX-CONTEXT.
           IF CBLC-EX-ACTIVE = 'Y'
               GO TO CBLC-TRY-MAIN-0-CATCH-0
           END-IF.
           GO TO CBLC-TRY-MAIN-0-DONE.
       CBLC-TRY-MAIN-0-CATCH-0.
           MOVE 'N' TO CBLC-EX-MATCHED.
           IF CBLC-EX-ACTIVE = 'Y' AND CBLC-EX-MATCHED = 'N' AND (CBLC-EX-TYPE-ID = 874186721)
               MOVE CBLC-EX-INT-PAYLOAD TO PORTFOLIO-FAILURE
               MOVE 'Y' TO CBLC-EX-MATCHED
           END-IF
           IF CBLC-EX-MATCHED = 'Y'
           DISPLAY "Portfolio exception handled"
           END-IF
           IF CBLC-EX-MATCHED = 'Y'
               MOVE 'N' TO CBLC-EX-ACTIVE
               PERFORM CBLC-EX-CLEAR-PAYLOAD
           MOVE 'N' TO CBLC-EX-ACTIVE
           MOVE 'N' TO CBLC-EX-MATCHED
           MOVE 0 TO CBLC-EX-TYPE-ID
           MOVE 0 TO CBLC-EX-DYNAMIC-TYPE-ID
           MOVE 0 TO CBLC-EX-PAYLOAD-SIZE
           MOVE 'N' TO CBLC-EX-PAYLOAD-OWNER
           MOVE 0 TO CBLC-EX-SOURCE-FILE-ID
           MOVE 0 TO CBLC-EX-SOURCE-LINE
           MOVE 0 TO CBLC-EX-SOURCE-COLUMN
           MOVE 0 TO CBLC-EX-SECONDARY-TYPE-ID
           MOVE 0 TO CBLC-EX-SECONDARY-SOURCE-LINE
           MOVE 0 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
           MOVE 0 TO CBLC-EX-INT-PAYLOAD
           MOVE 0 TO CBLC-EX-STRING-LEN
           MOVE SPACES TO CBLC-EX-STRING-BUF
           MOVE 'N' TO CBLC-EX-RAISING
           MOVE 'N' TO CBLC-EX-CLEANING
           END-IF
           MOVE 'N' TO CBLC-EX-MATCHED.
       CBLC-TRY-MAIN-0-DONE.
           IF CBLC-EX-ACTIVE = 'Y'
               DISPLAY "Unhandled CBL-C exception"
               STOP RUN
           END-IF.
           CALL 'SHOWCASE-MEMORY'
               ON EXCEPTION
                   IF CBLC-EX-ACTIVE = 'Y' OR CBLC-EX-RAISING = 'Y' OR CBLC-EX-CLEANING = 'Y'
                       MOVE 874186721 TO CBLC-EX-SECONDARY-TYPE-ID
                       MOVE 23 TO CBLC-EX-SECONDARY-SOURCE-LINE
                       MOVE 5 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
                       PERFORM CBLC-TERMINATE
                   END-IF
                   MOVE 1 TO CBLC-EX-INT-PAYLOAD
                   MOVE 4 TO CBLC-EX-PAYLOAD-SIZE
                   MOVE 874186721 TO CBLC-EX-TYPE-ID
                   MOVE 874186721 TO CBLC-EX-DYNAMIC-TYPE-ID
                   MOVE 'Y' TO CBLC-EX-PAYLOAD-OWNER
                   MOVE 'Y' TO CBLC-EX-ACTIVE
           END-CALL.
           IF CBLC-EX-ACTIVE = 'Y'
               STOP RUN
           END-IF.
           CALL 'ADJUST-MODULE-COUNT' USING BY REFERENCE MODULE-COUNT BY REFERENCE MODULE-DELTA
               ON EXCEPTION
                   IF CBLC-EX-ACTIVE = 'Y' OR CBLC-EX-RAISING = 'Y' OR CBLC-EX-CLEANING = 'Y'
                       MOVE 874186721 TO CBLC-EX-SECONDARY-TYPE-ID
                       MOVE 24 TO CBLC-EX-SECONDARY-SOURCE-LINE
                       MOVE 5 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
                       PERFORM CBLC-TERMINATE
                   END-IF
                   MOVE 1 TO CBLC-EX-INT-PAYLOAD
                   MOVE 4 TO CBLC-EX-PAYLOAD-SIZE
                   MOVE 874186721 TO CBLC-EX-TYPE-ID
                   MOVE 874186721 TO CBLC-EX-DYNAMIC-TYPE-ID
                   MOVE 'Y' TO CBLC-EX-PAYLOAD-OWNER
                   MOVE 'Y' TO CBLC-EX-ACTIVE
           END-CALL.
           IF CBLC-EX-ACTIVE = 'Y'
               STOP RUN
           END-IF.
           DISPLAY "Modules".
           DISPLAY MODULE-COUNT.
           DISPLAY "SHOWCASE READY".
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
               FREE BOOK-UNDERWRITING-NAME-PTR
           END-IF.
           SET BOOK-UNDERWRITING-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-CAP.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-PTR NOT = NULL
               FREE BOOK-CLAIMS-NAME-PTR
           END-IF.
           SET BOOK-CLAIMS-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-CLAIMS-NAME-CAP.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           STOP RUN.
       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

           STOP RUN.

       CBLC-TERMINATE.
           DISPLAY "Fatal CBL-C double exception"
           DISPLAY "Original exception type: " CBLC-EX-TYPE-ID
           DISPLAY "Original exception file ID: " CBLC-EX-SOURCE-FILE-ID
           DISPLAY "Original exception line: " CBLC-EX-SOURCE-LINE
           DISPLAY "Original exception column: " CBLC-EX-SOURCE-COLUMN
           DISPLAY "Secondary exception type: " CBLC-EX-SECONDARY-TYPE-ID
           DISPLAY "Secondary exception line: " CBLC-EX-SECONDARY-SOURCE-LINE
           DISPLAY "Secondary exception column: " CBLC-EX-SECONDARY-SOURCE-COLUMN
           STOP RUN.

       END PROGRAM MAIN.

