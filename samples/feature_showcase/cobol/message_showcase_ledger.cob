       IDENTIFICATION DIVISION.
       PROGRAM-ID. SHOWCASE-PORTFOLIO.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 RESERVE-TARGET PIC S9(9) VALUE 600000.
       01 EARNED-PREMIUM PIC S9(9) VALUE 480000.
       01 TITLE PIC X(16) VALUE "POLICY SNAPSHOT".
       01 NOTE PIC X(16).
       01 TITLE-LENGTH PIC S9(9).
       01 NOTE-LENGTH PIC S9(9).
       01 LEDGER-MARKER-BUFFER USAGE POINTER VALUE NULL.
       01 LEDGER-MARKER PIC X(1).
       01 SHOWCASELEDGER-CTOR-ID PIC S9(9).
       01 SHOWCASELEDGER-LOAD-POLICIES PIC S9(9).
       01 SHOWCASELEDGER-LOAD-CLAIMS PIC S9(9).
       01 SHOWCASELEDGER-LOAD-INVESTIGATIONS PIC S9(9).
       01 SHOWCASELEDGER-LOAD-PAID PIC S9(9).
       01 BOOK.
       05 BOOK-UNDERWRITING.
       10 BOOK-UNDERWRITING-NAME PIC X(16).
       10 BOOK-UNDERWRITING-OPEN-ITEMS PIC S9(9).
       10 BOOK-UNDERWRITING-CLOSED-ITEMS PIC S9(9).
       05 BOOK-CLAIMS.
       10 BOOK-CLAIMS-NAME PIC X(16).
       10 BOOK-CLAIMS-OPEN-ITEMS PIC S9(9).
       10 BOOK-CLAIMS-CLOSED-ITEMS PIC S9(9).
       01 OUTPUT-REPORT-ID PIC S9(9).
       01 POLICIES-TOTAL PIC S9(9).
       01 CLAIMS-NET PIC S9(9).
       01 WEIGHTED-TOTAL PIC S9(9).
       01 LOSS-RATIO PIC S9(9).
       01 RESERVE-GAP-AMOUNT PIC S9(9).
       01 SHOWCASE-PORTFOLIO-RISK-REVIEW.
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG PIC X(16).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE PIC S9(9).
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID PIC S9(9) 
           VALUE 0.
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES PIC 
           S9(9) VALUE 0.
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS 
           PIC S9(9) VALUE 0.
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE PIC 
           S9(9) VALUE 0.
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT PIC S9(9) VALUE 0.
       01 CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP 
           PIC S9(9) VALUE 0.
       01 CBLC-PTR-CURSOR USAGE POINTER VALUE NULL.
       01 CBLC-PTR-OFFSET PIC S9(9) VALUE 0.
       01 CBLC-PTR-CHAR BASED PIC X.
       01 CBLC-PTR-INT BASED PIC S9(9) COMP-5.
       01 CBLC-PTR-INT-PTR BASED USAGE POINTER.
       01 CBLC-PTR-CHAR-2 BASED PIC X.
       01 CBLC-PTR-INT-2 BASED PIC S9(9) COMP-5.
       01 CBLC-PTR-INT-PTR-2 BASED USAGE POINTER.
       LINKAGE SECTION.
       01 CBLC-EX-CONTEXT.
          05 CBLC-EX-ACTIVE PIC X.
          05 CBLC-EX-MATCHED PIC X.
          05 CBLC-EX-TYPE-ID PIC 9(10) COMP-5.
          05 CBLC-EX-DYNAMIC-TYPE-ID PIC 9(10) COMP-5.
          05 CBLC-EX-PAYLOAD-SIZE PIC 9(9) COMP-5.
          05 CBLC-EX-PAYLOAD-OWNER PIC X.
          05 CBLC-EX-SOURCE-FILE-ID PIC 9(10) COMP-5.
          05 CBLC-EX-SOURCE-LINE PIC 9(9) COMP-5.
          05 CBLC-EX-SOURCE-COLUMN PIC 9(9) COMP-5.
          05 CBLC-EX-RAISING PIC X.
          05 CBLC-EX-CLEANING PIC X.
          05 CBLC-EX-SECONDARY-TYPE-ID PIC 9(10) COMP-5.
          05 CBLC-EX-SECONDARY-SOURCE-LINE PIC 9(9) COMP-5.
          05 CBLC-EX-SECONDARY-SOURCE-COLUMN PIC 9(9) COMP-5.
          05 CBLC-EX-INT-PAYLOAD PIC S9(9).
          05 CBLC-EX-MESSAGE.
             10 CBLC-EX-MESSAGE-LEN PIC 9(4) COMP.
             10 CBLC-EX-MESSAGE-BUF PIC X(256).
       PROCEDURE DIVISION USING CBLC-EX-CONTEXT.
       SHOWCASE-PORTFOLIO.
           MOVE 3 TO SHOWCASELEDGER-CTOR-ID.
           PERFORM 
           CBLC-CONSTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW-0 THRU CBLC-CRET-33-0.
           IF CBLC-EX-ACTIVE = 'Y'
               GO TO CBLC-FRETURN-0
           END-IF.
           MOVE "UNDERWRITING" TO BOOK-UNDERWRITING-NAME.
           COMPUTE BOOK-UNDERWRITING-OPEN-ITEMS = 19.
           COMPUTE BOOK-UNDERWRITING-CLOSED-ITEMS = 23.
           MOVE "CLAIMS" TO BOOK-CLAIMS-NAME.
           COMPUTE BOOK-CLAIMS-OPEN-ITEMS = 32.
           COMPUTE BOOK-CLAIMS-CLOSED-ITEMS = 27.
           MOVE 1250 TO SHOWCASELEDGER-LOAD-POLICIES.
           MOVE 32 TO SHOWCASELEDGER-LOAD-CLAIMS.
           MOVE 5 TO SHOWCASELEDGER-LOAD-INVESTIGATIONS.
           MOVE 72000 TO SHOWCASELEDGER-LOAD-PAID.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           PERFORM 
           CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           COMPUTE OUTPUT-REPORT-ID = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           COMPUTE POLICIES-TOTAL = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           PERFORM 
           CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           COMPUTE CLAIMS-NET = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           COMPUTE WEIGHTED-TOTAL = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           PERFORM 
           CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           COMPUTE LOSS-RATIO = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           PERFORM 
           CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           COMPUTE RESERVE-GAP-AMOUNT = 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           DISPLAY BOOK-UNDERWRITING-NAME.
           DISPLAY BOOK-CLAIMS-NAME.
           DISPLAY "Policies".
           DISPLAY POLICIES-TOTAL.
           DISPLAY "Net claims".
           DISPLAY CLAIMS-NET.
           DISPLAY "Weighted score".
           DISPLAY WEIGHTED-TOTAL.
           DISPLAY "Loss ratio".
           DISPLAY LOSS-RATIO.
           DISPLAY "Reserve gap".
           DISPLAY RESERVE-GAP-AMOUNT.
           DISPLAY "Snapshot id".
           DISPLAY OUTPUT-REPORT-ID.
           PERFORM CBLC-DESTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT.
           MOVE SPACES TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER.
           GOBACK.
       CBLC-EX-CLEANUP-SHOWCASE-PORTFOLIO-1.
           MOVE 'Y' TO CBLC-EX-CLEANING.
           PERFORM CBLC-DESTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT.
           MOVE SPACES TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG.
           MOVE 0 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER.
           MOVE 'N' TO CBLC-EX-CLEANING.
           EXIT.

       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

       CBLC-EX-CLEAR-PAYLOAD-END.
           EXIT.

           GOBACK.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = 
           SHOWCASELEDGER-LOAD-POLICIES.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = 
           SHOWCASELEDGER-LOAD-CLAIMS.
           COMPUTE 
           SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = SHOWCASELEDGER-LOAD-INVESTIGATIONS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = 
           SHOWCASELEDGER-LOAD-PAID.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE 
           = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT / 250 + SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED.
           EXIT.
       CBLC-MRET-33-0.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           COMPUTE CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID = 0.
           COMPUTE CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID 
           = SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER.
           EXIT.
       CBLC-MRET-33-1.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES = 0.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT.
           EXIT.
       CBLC-MRET-33-2.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS = 0.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS = SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           EXIT.
       CBLC-MRET-33-3.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           COMPUTE CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE = 0.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE = SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           EXIT.
       CBLC-MRET-33-4.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT = 0.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT = SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS * 100 / EARNED-PREMIUM.
           EXIT.
       CBLC-MRET-33-5.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP = 0.
           COMPUTE 
           CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP = RESERVE-TARGET - EARNED-PREMIUM.
           EXIT.
       CBLC-MRET-33-6.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
           DISPLAY SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG.
           DISPLAY "Memory marker".
           DISPLAY LEDGER-MARKER.
           EXIT.
       CBLC-MRET-33-7.
           EXIT.

       CBLC-CONSTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW-0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER = 
           SHOWCASELEDGER-CTOR-ID.
           MOVE "BASE" TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = 0.
           COMPUTE 
           SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED = 23.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE = 0.
           ALLOCATE 4 CHARACTERS RETURNING LEDGER-MARKER-BUFFER.
           SET CBLC-PTR-CURSOR TO LEDGER-MARKER-BUFFER.
           SET ADDRESS OF CBLC-PTR-CHAR TO CBLC-PTR-CURSOR.
           MOVE "R" TO CBLC-PTR-CHAR.
           SET CBLC-PTR-CURSOR TO LEDGER-MARKER-BUFFER.
           SET ADDRESS OF CBLC-PTR-CHAR TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-CHAR TO LEDGER-MARKER.
       CBLC-CRET-33-0.
           EXIT.

       CBLC-DESTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW.
           FREE LEDGER-MARKER-BUFFER.
           EXIT.

       CBLC-TERMINATE.
           DISPLAY "Fatal CBL-C double exception"
           DISPLAY "Original exception type: " CBLC-EX-TYPE-ID
           DISPLAY "Original exception file ID: " CBLC-EX-SOURCE-FILE-ID
           DISPLAY "Original exception line: " CBLC-EX-SOURCE-LINE
           DISPLAY "Original exception column: " CBLC-EX-SOURCE-COLUMN
           DISPLAY "Secondary exception type: " 
           CBLC-EX-SECONDARY-TYPE-ID
           DISPLAY "Secondary exception line: " 
           CBLC-EX-SECONDARY-SOURCE-LINE
           DISPLAY "Secondary exception column: " 
           CBLC-EX-SECONDARY-SOURCE-COLUMN
           STOP RUN.

       END PROGRAM SHOWCASE-PORTFOLIO.

