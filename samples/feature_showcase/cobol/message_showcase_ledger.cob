       IDENTIFICATION DIVISION.
       PROGRAM-ID. SHOWCASE-PORTFOLIO.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 RESERVE-TARGET PIC S9(9) VALUE 600000.
       01 EARNED-PREMIUM PIC S9(9) VALUE 480000.
       01 TITLE.
          05 TITLE-LEN PIC 9(4) COMP VALUE 0.
          05 TITLE-CAP PIC 9(4) COMP VALUE 0.
          05 TITLE-PTR USAGE POINTER VALUE NULL.
       01 TITLE-BUF BASED PIC X(15).
       01 NOTE.
          05 NOTE-LEN PIC 9(4) COMP VALUE 0.
          05 NOTE-CAP PIC 9(4) COMP VALUE 0.
          05 NOTE-PTR USAGE POINTER VALUE NULL.
       01 NOTE-BUF BASED PIC X(16).
       01 TITLE-LENGTH PIC S9(9).
       01 NOTE-LENGTH PIC S9(9).
       01 LEDGER-MARKER-BUFFER USAGE POINTER VALUE NULL.
       01 LEDGER-MARKER PIC X(1).
       01 SHOWCASELEDGER-CTOR-ID PIC S9(9).
       01 SHOWCASELEDGER-LOAD-POLICIES PIC S9(9).
       01 SHOWCASELEDGER-LOAD-CLAIMS PIC S9(9).
       01 SHOWCASELEDGER-LOAD-INVESTIGATIONS PIC S9(9).
       01 SHOWCASELEDGER-LOAD-PAID PIC S9(9).
       01 BOOK.
       05 BOOK-UNDERWRITING.
       10 BOOK-UNDERWRITING-NAME.
       15 BOOK-UNDERWRITING-NAME-LEN PIC 9(4) COMP VALUE 0.
       15 BOOK-UNDERWRITING-NAME-CAP PIC 9(4) COMP VALUE 0.
       15 BOOK-UNDERWRITING-NAME-PTR USAGE POINTER VALUE NULL.
       10 BOOK-UNDERWRITING-OPEN-ITEMS PIC S9(9).
       10 BOOK-UNDERWRITING-CLOSED-ITEMS PIC S9(9).
       05 BOOK-CLAIMS.
       10 BOOK-CLAIMS-NAME.
       15 BOOK-CLAIMS-NAME-LEN PIC 9(4) COMP VALUE 0.
       15 BOOK-CLAIMS-NAME-CAP PIC 9(4) COMP VALUE 0.
       15 BOOK-CLAIMS-NAME-PTR USAGE POINTER VALUE NULL.
       10 BOOK-CLAIMS-OPEN-ITEMS PIC S9(9).
       10 BOOK-CLAIMS-CLOSED-ITEMS PIC S9(9).
       01 BOOK-UNDERWRITING-NAME-BUF BASED PIC X(16).
       01 BOOK-CLAIMS-NAME-BUF BASED PIC X(16).
       01 OUTPUT-REPORT-ID PIC S9(9).
       01 POLICIES-TOTAL PIC S9(9).
       01 CLAIMS-NET PIC S9(9).
       01 WEIGHTED-TOTAL PIC S9(9).
       01 LOSS-RATIO PIC S9(9).
       01 RESERVE-GAP-AMOUNT PIC S9(9).
       01 SHOWCASE-PORTFOLIO-RISK-REVIEW.
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG.
       10 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-LEN PIC 9(4) COMP VALUE 0.
       10 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP PIC 9(4) COMP VALUE 0.
       10 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR USAGE POINTER VALUE NULL.
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED PIC S9(9).
       05 SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE PIC S9(9).
       01 SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF BASED PIC X(16).
       01 CBLC-PTR-CURSOR USAGE POINTER VALUE NULL.
       01 CBLC-PTR-OFFSET PIC S9(9) VALUE 0.
       01 CBLC-PTR-CHAR BASED PIC X.
       01 CBLC-PTR-INT BASED PIC S9(9).
       01 CBLC-PTR-INT-PTR BASED USAGE POINTER.
       PROCEDURE DIVISION.
       SHOWCASE-PORTFOLIO.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-CAP < 15
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               ALLOCATE 15 CHARACTERS RETURNING TITLE-PTR
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               COMPUTE TITLE-CAP = 15
           END-IF.
           MOVE "POLICY SNAPSHOT" TO TITLE-BUF.
           COMPUTE TITLE-LEN = 15.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-CAP < 16
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 16
           END-IF.
           MOVE SPACES TO NOTE-BUF.
           COMPUTE SHOWCASELEDGER-CTOR-ID = 3.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER = SHOWCASELEDGER-CTOR-ID.
           IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP < 4
               IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR NOT = NULL
                   FREE SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               END-IF
               ALLOCATE 4 CHARACTERS RETURNING SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               SET ADDRESS OF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP = 4
           END-IF.
           SET ADDRESS OF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
           MOVE "BASE" TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF.
           MOVE 4 TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-LEN.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = 0.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED = 23.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE = 0.
           ALLOCATE 4 CHARACTERS RETURNING LEDGER-MARKER-BUFFER.
           SET CBLC-PTR-CURSOR TO LEDGER-MARKER-BUFFER.
           SET ADDRESS OF CBLC-PTR-CHAR TO CBLC-PTR-CURSOR.
           MOVE "R" TO CBLC-PTR-CHAR.
           SET CBLC-PTR-CURSOR TO LEDGER-MARKER-BUFFER.
           SET ADDRESS OF CBLC-PTR-CHAR TO CBLC-PTR-CURSOR.
           MOVE CBLC-PTR-CHAR TO LEDGER-MARKER.
           IF BOOK-UNDERWRITING-NAME-CAP < 12
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 12 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 12
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF TO BOOK-UNDERWRITING-NAME-PTR
           MOVE "UNDERWRITING" TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 12 TO BOOK-UNDERWRITING-NAME-LEN.
           COMPUTE BOOK-UNDERWRITING-OPEN-ITEMS = 19.
           COMPUTE BOOK-UNDERWRITING-CLOSED-ITEMS = 23.
           IF BOOK-CLAIMS-NAME-CAP < 6
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 6 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 6
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           MOVE "CLAIMS" TO BOOK-CLAIMS-NAME-BUF.
           MOVE 6 TO BOOK-CLAIMS-NAME-LEN.
           COMPUTE BOOK-CLAIMS-OPEN-ITEMS = 32.
           COMPUTE BOOK-CLAIMS-CLOSED-ITEMS = 27.
           COMPUTE SHOWCASELEDGER-LOAD-POLICIES = 1250.
           COMPUTE SHOWCASELEDGER-LOAD-CLAIMS = 32.
           COMPUTE SHOWCASELEDGER-LOAD-INVESTIGATIONS = 5.
           COMPUTE SHOWCASELEDGER-LOAD-PAID = 72000.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = SHOWCASELEDGER-LOAD-POLICIES.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = SHOWCASELEDGER-LOAD-CLAIMS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = SHOWCASELEDGER-LOAD-INVESTIGATIONS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = SHOWCASELEDGER-LOAD-PAID.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT / 250 + SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED.
           IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP < 1
               IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR NOT = NULL
                   FREE SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               SET ADDRESS OF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP = 1
           END-IF.
           SET ADDRESS OF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF TO SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
           DISPLAY SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-BUF(1:SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-LEN).
           DISPLAY "Memory marker".
           DISPLAY LEDGER-MARKER.
           COMPUTE OUTPUT-REPORT-ID = SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER.
           COMPUTE POLICIES-TOTAL = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT.
           COMPUTE CLAIMS-NET = SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           COMPUTE WEIGHTED-TOTAL = SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           COMPUTE LOSS-RATIO = SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS * 100 / EARNED-PREMIUM.
           COMPUTE RESERVE-GAP-AMOUNT = RESERVE-TARGET - EARNED-PREMIUM.
           IF BOOK-UNDERWRITING-NAME-CAP < 1
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF TO BOOK-UNDERWRITING-NAME-PTR
           DISPLAY BOOK-UNDERWRITING-NAME-BUF(1:BOOK-UNDERWRITING-NAME-LEN).
           IF BOOK-CLAIMS-NAME-CAP < 1
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           DISPLAY BOOK-CLAIMS-NAME-BUF(1:BOOK-CLAIMS-NAME-LEN).
           DISPLAY "Policies".
           DISPLAY POLICIES-TOTAL.
           DISPLAY "Net claims".
           DISPLAY CLAIMS-NET.
           DISPLAY "Weighted score".
           DISPLAY WEIGHTED-TOTAL.
           DISPLAY "Loss ratio".
           DISPLAY LOSS-RATIO.
           DISPLAY "Reserve gap".
           DISPLAY RESERVE-GAP-AMOUNT.
           DISPLAY "Snapshot id".
           DISPLAY OUTPUT-REPORT-ID.
           FREE LEDGER-MARKER-BUFFER.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-PTR NOT = NULL
               FREE NOTE-PTR
           END-IF.
           SET NOTE-PTR TO NULL.
           MOVE 0 TO NOTE-CAP.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-PTR NOT = NULL
               FREE TITLE-PTR
           END-IF.
           SET TITLE-PTR TO NULL.
           MOVE 0 TO TITLE-CAP.
           GOBACK.

       END PROGRAM SHOWCASE-PORTFOLIO.

