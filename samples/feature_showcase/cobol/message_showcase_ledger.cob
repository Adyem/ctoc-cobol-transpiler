       PROCEDURE DIVISION.
       SHOWCASE-PORTFOLIO.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-CAP < 15
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               ALLOCATE 15 CHARACTERS RETURNING TITLE-PTR
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               COMPUTE TITLE-CAP = 15
           END-IF.
           MOVE "POLICY SNAPSHOT" TO TITLE-BUF.
           COMPUTE TITLE-LEN = 15.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-CAP < 16
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 16
           END-IF.
           MOVE SPACES TO NOTE-BUF.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-CAP < 1
               IF SUFFIX-PTR NOT = NULL
                   FREE SUFFIX-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING SUFFIX-PTR
               SET ADDRESS OF SUFFIX-BUF TO SUFFIX-PTR
               COMPUTE SUFFIX-CAP = 1
           END-IF.
           MOVE "!" TO SUFFIX-BUF.
           COMPUTE SUFFIX-LEN = 1.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-CAP < 16
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING 
      -    BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-CAP < 16
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  
      -    TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-CLAIMS-NAME-BUF.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           COMPUTE SHOWCASELEDGER-CTOR-ID = 3.
           PERFORM CBLC-CONSTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW-0.
           IF BOOK-UNDERWRITING-NAME-CAP < 12
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 12 CHARACTERS RETURNING 
      -    BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 12
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
           MOVE "UNDERWRITING" TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 12 TO BOOK-UNDERWRITING-NAME-LEN.
           COMPUTE BOOK-UNDERWRITING-OPEN-ITEMS = 19.
           COMPUTE BOOK-UNDERWRITING-CLOSED-ITEMS = 23.
           IF BOOK-CLAIMS-NAME-CAP < 6
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 6 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  
      -    TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 6
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           MOVE "CLAIMS" TO BOOK-CLAIMS-NAME-BUF.
           MOVE 6 TO BOOK-CLAIMS-NAME-LEN.
           COMPUTE BOOK-CLAIMS-OPEN-ITEMS = 32.
           COMPUTE BOOK-CLAIMS-CLOSED-ITEMS = 27.
           COMPUTE SHOWCASELEDGER-LOAD-POLICIES = 1250.
           COMPUTE SHOWCASELEDGER-LOAD-CLAIMS = 32.
           COMPUTE SHOWCASELEDGER-LOAD-INVESTIGATIONS = 5.
           COMPUTE SHOWCASELEDGER-LOAD-PAID = 72000.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           PERFORM 
      -    CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           COMPUTE OUTPUT-REPORT-ID = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           COMPUTE POLICIES-TOTAL = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           PERFORM 
      -    CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           COMPUTE CLAIMS-NET = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           COMPUTE WEIGHTED-TOTAL = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           PERFORM 
      -    CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           COMPUTE LOSS-RATIO = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           PERFORM 
      -    CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           COMPUTE RESERVE-GAP-AMOUNT = 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           IF BOOK-UNDERWRITING-NAME-CAP < 1
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING 
      -    BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  
      -    TO BOOK-UNDERWRITING-NAME-PTR
           DISPLAY 
      -    BOOK-UNDERWRITING-NAME-BUF(1:BOOK-UNDERWRITING-NAME-LEN).
           IF BOOK-CLAIMS-NAME-CAP < 1
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  
      -    TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           DISPLAY BOOK-CLAIMS-NAME-BUF(1:BOOK-CLAIMS-NAME-LEN).
           DISPLAY "Policies".
           DISPLAY POLICIES-TOTAL.
           DISPLAY "Net claims".
           DISPLAY CLAIMS-NET.
           DISPLAY "Weighted score".
           DISPLAY WEIGHTED-TOTAL.
           DISPLAY "Loss ratio".
           DISPLAY LOSS-RATIO.
           DISPLAY "Reserve gap".
           DISPLAY RESERVE-GAP-AMOUNT.
           DISPLAY "Snapshot id".
           DISPLAY OUTPUT-REPORT-ID.
           PERFORM CBLC-DESTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
               FREE BOOK-UNDERWRITING-NAME-PTR
           END-IF.
           SET BOOK-UNDERWRITING-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-CAP.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-PTR NOT = NULL
               FREE BOOK-CLAIMS-NAME-PTR
           END-IF.
           SET BOOK-CLAIMS-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-CLAIMS-NAME-CAP.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-PTR NOT = NULL
               FREE SUFFIX-PTR
           END-IF.
           SET SUFFIX-PTR TO NULL.
           MOVE 0 TO SUFFIX-CAP.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-PTR NOT = NULL
               FREE NOTE-PTR
           END-IF.
           SET NOTE-PTR TO NULL.
           MOVE 0 TO NOTE-CAP.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-PTR NOT = NULL
               FREE TITLE-PTR
           END-IF.
           SET TITLE-PTR TO NULL.
           MOVE 0 TO TITLE-CAP.
           GOBACK.
       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

           GOBACK.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = 
      -    SHOWCASELEDGER-LOAD-POLICIES.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = 
      -    SHOWCASELEDGER-LOAD-CLAIMS.
           COMPUTE 
      -    SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = SHOWCASELEDGER-LOAD-INVESTIGATIONS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = 
      -    SHOWCASELEDGER-LOAD-PAID.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE 
      -    = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT / 250 + SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID.
           COMPUTE CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-ID 
      -    = SHOWCASE-PORTFOLIO-RISK-REVIEW-IDENTIFIER.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES.
           COMPUTE 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICIES = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS.
           COMPUTE 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-NET-CLAIMS = SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE.
           COMPUTE 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-SCORE = SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT.
           COMPUTE 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOSS-RATIO-PERCENT = SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS * 100 / EARNED-PREMIUM.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP.
           COMPUTE 
      -    CBLC-RESULT-SHOWCASE-PORTFOLIO-RISK-REVIEW-RESERVE-GAP = RESERVE-TARGET - EARNED-PREMIUM.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
           IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-CAP < 1
               IF SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR NOT = NULL
                   FREE SHOWCASE-PORTFOLIO-RISK-REVIEW-TAG-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING 
