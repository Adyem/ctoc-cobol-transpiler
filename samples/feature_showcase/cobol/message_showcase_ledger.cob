       PROCEDURE DIVISION USING CBLC-EX-CONTEXT.
       SHOWCASE-PORTFOLIO.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-CAP < 15
               IF TITLE-PTR NOT = NULL
                   FREE TITLE-PTR
               END-IF
               ALLOCATE 15 CHARACTERS RETURNING TITLE-PTR
               SET ADDRESS OF TITLE-BUF TO TITLE-PTR
               COMPUTE TITLE-CAP = 15
           END-IF.
           MOVE "POLICY SNAPSHOT" TO TITLE-BUF.
           COMPUTE TITLE-LEN = 15.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-CAP < 16
               IF NOTE-PTR NOT = NULL
                   FREE NOTE-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING NOTE-PTR
               SET ADDRESS OF NOTE-BUF TO NOTE-PTR
               COMPUTE NOTE-CAP = 16
           END-IF.
           MOVE SPACES TO NOTE-BUF.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-CAP < 1
               IF SUFFIX-PTR NOT = NULL
                   FREE SUFFIX-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING SUFFIX-PTR
               SET ADDRESS OF SUFFIX-BUF TO SUFFIX-PTR
               COMPUTE SUFFIX-CAP = 1
           END-IF.
           MOVE "!" TO SUFFIX-BUF.
           COMPUTE SUFFIX-LEN = 1.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-CAP < 16
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-CAP < 16
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 16 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 16
           END-IF.
           MOVE SPACES TO BOOK-CLAIMS-NAME-BUF.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           COMPUTE LEDGER-CTOR-ID = 3.
           PERFORM CBLC-CONSTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW-0.
           IF BOOK-UNDERWRITING-NAME-CAP < 12
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 12 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 12
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
           MOVE "UNDERWRITING" TO BOOK-UNDERWRITING-NAME-BUF.
           MOVE 12 TO BOOK-UNDERWRITING-NAME-LEN.
           COMPUTE BOOK-UNDERWRITING-OPEN-ITEMS = 19.
           COMPUTE BOOK-UNDERWRITING-CLOSED-ITEMS = 23.
           IF BOOK-CLAIMS-NAME-CAP < 6
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 6 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 6
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           MOVE "CLAIMS" TO BOOK-CLAIMS-NAME-BUF.
           MOVE 6 TO BOOK-CLAIMS-NAME-LEN.
           COMPUTE BOOK-CLAIMS-OPEN-ITEMS = 32.
           COMPUTE BOOK-CLAIMS-CLOSED-ITEMS = 27.
           COMPUTE LEDGER-LOAD-POLICIES = 1250.
           COMPUTE LEDGER-LOAD-CLAIMS = 32.
           COMPUTE LEDGER-LOAD-INVESTIGATIONS = 5.
           COMPUTE LEDGER-LOAD-PAID = 72000.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           PERFORM CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
           COMPUTE OUTPUT-REPORT-ID = 3.
           COMPUTE POLICIES-TOTAL = 1250.
           COMPUTE CLAIMS-NET = 27.
           COMPUTE WEIGHTED-TOTAL = 23.
           COMPUTE LOSS-RATIO = 15.
           COMPUTE RESERVE-GAP-AMOUNT = 120000.
           COMPUTE WEIGHTED-TOTAL = WEIGHTED-TOTAL + 1.
           COMPUTE SCORE-SNAPSHOT = WEIGHTED-TOTAL.
           IF BOOK-UNDERWRITING-NAME-CAP < 1
               IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
                   FREE BOOK-UNDERWRITING-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING BOOK-UNDERWRITING-NAME-PTR
               SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
               COMPUTE BOOK-UNDERWRITING-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-UNDERWRITING-NAME-BUF  TO BOOK-UNDERWRITING-NAME-PTR
           DISPLAY BOOK-UNDERWRITING-NAME-BUF(1:BOOK-UNDERWRITING-NAME-LEN).
           IF BOOK-CLAIMS-NAME-CAP < 1
               IF BOOK-CLAIMS-NAME-PTR NOT = NULL
                   FREE BOOK-CLAIMS-NAME-PTR
               END-IF
               ALLOCATE 1 CHARACTERS RETURNING BOOK-CLAIMS-NAME-PTR
               SET ADDRESS OF BOOK-CLAIMS-NAME-BUF  TO BOOK-CLAIMS-NAME-PTR
               COMPUTE BOOK-CLAIMS-NAME-CAP = 1
           END-IF.
           SET ADDRESS OF BOOK-CLAIMS-NAME-BUF TO BOOK-CLAIMS-NAME-PTR
           DISPLAY BOOK-CLAIMS-NAME-BUF(1:BOOK-CLAIMS-NAME-LEN).
           DISPLAY "Policies".
           DISPLAY POLICIES-TOTAL.
           DISPLAY "Net claims".
           DISPLAY CLAIMS-NET.
           DISPLAY "Weighted score".
           DISPLAY WEIGHTED-TOTAL.
           DISPLAY "Score snapshot".
           DISPLAY SCORE-SNAPSHOT.
           DISPLAY "Loss ratio".
           DISPLAY LOSS-RATIO.
           DISPLAY "Reserve gap".
           DISPLAY RESERVE-GAP-AMOUNT.
           DISPLAY "Snapshot id".
           DISPLAY OUTPUT-REPORT-ID.
           MOVE 'N' TO CBLC-EX-ACTIVE.
           MOVE 'N' TO CBLC-EX-MATCHED.
           IF CBLC-EX-RAISING = 'Y' OR CBLC-EX-CLEANING = 'Y'
               MOVE 874186721 TO CBLC-EX-SECONDARY-TYPE-ID
               MOVE 118 TO CBLC-EX-SECONDARY-SOURCE-LINE
               MOVE 9 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
               PERFORM CBLC-TERMINATE
           END-IF.
           MOVE 'Y' TO CBLC-EX-RAISING.
           MOVE CLAIMS-NET TO CBLC-EX-INT-PAYLOAD.
           MOVE 4 TO CBLC-EX-PAYLOAD-SIZE.
           MOVE 874186721 TO CBLC-EX-TYPE-ID.
           MOVE 874186721 TO CBLC-EX-DYNAMIC-TYPE-ID.
           MOVE 118 TO CBLC-EX-SOURCE-LINE.
           MOVE 812673107 TO CBLC-EX-SOURCE-FILE-ID.
           MOVE 9 TO CBLC-EX-SOURCE-COLUMN.
           MOVE 'Y' TO CBLC-EX-PAYLOAD-OWNER.
           MOVE 'Y' TO CBLC-EX-ACTIVE.
           MOVE 'N' TO CBLC-EX-RAISING.
           GO TO CBLC-TRY-SHOWCASE-PORTFOLIO-0-CATCH-0.
           GO TO CBLC-TRY-SHOWCASE-PORTFOLIO-0-DONE.
       CBLC-TRY-SHOWCASE-PORTFOLIO-0-CATCH-0.
           MOVE 'N' TO CBLC-EX-MATCHED.
           IF CBLC-EX-ACTIVE = 'Y' AND CBLC-EX-MATCHED = 'N' AND (CBLC-EX-TYPE-ID = 874186721)
               MOVE CBLC-EX-INT-PAYLOAD TO FAILED-INVESTIGATIONS
               MOVE 'Y' TO CBLC-EX-MATCHED
           END-IF
           IF CBLC-EX-MATCHED = 'Y'
           DISPLAY "Claim batch rejected"
           END-IF
           IF CBLC-EX-MATCHED = 'Y'
               MOVE 'N' TO CBLC-EX-ACTIVE
               PERFORM CBLC-EX-CLEAR-PAYLOAD
           MOVE 'N' TO CBLC-EX-ACTIVE
           MOVE 'N' TO CBLC-EX-MATCHED
           MOVE 0 TO CBLC-EX-TYPE-ID
           MOVE 0 TO CBLC-EX-DYNAMIC-TYPE-ID
           MOVE 0 TO CBLC-EX-PAYLOAD-SIZE
           MOVE 'N' TO CBLC-EX-PAYLOAD-OWNER
           MOVE 0 TO CBLC-EX-SOURCE-FILE-ID
           MOVE 0 TO CBLC-EX-SOURCE-LINE
           MOVE 0 TO CBLC-EX-SOURCE-COLUMN
           MOVE 0 TO CBLC-EX-SECONDARY-TYPE-ID
           MOVE 0 TO CBLC-EX-SECONDARY-SOURCE-LINE
           MOVE 0 TO CBLC-EX-SECONDARY-SOURCE-COLUMN
           MOVE 0 TO CBLC-EX-INT-PAYLOAD
           MOVE 0 TO CBLC-EX-STRING-LEN
           MOVE SPACES TO CBLC-EX-STRING-BUF
           MOVE 'N' TO CBLC-EX-RAISING
           MOVE 'N' TO CBLC-EX-CLEANING
           END-IF
           MOVE 'N' TO CBLC-EX-MATCHED.
       CBLC-TRY-SHOWCASE-PORTFOLIO-0-DONE.
           IF CBLC-EX-ACTIVE = 'Y'
               DISPLAY "Unhandled CBL-C exception"
               GOBACK
           END-IF.
           PERFORM CBLC-DESTRUCTOR-SHOWCASE-PORTFOLIO-RISK-REVIEW.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-LEN.
           IF BOOK-UNDERWRITING-NAME-PTR NOT = NULL
               FREE BOOK-UNDERWRITING-NAME-PTR
           END-IF.
           SET BOOK-UNDERWRITING-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-UNDERWRITING-NAME-CAP.
           MOVE 0 TO BOOK-UNDERWRITING-OPEN-ITEMS.
           MOVE 0 TO BOOK-UNDERWRITING-CLOSED-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-NAME-LEN.
           IF BOOK-CLAIMS-NAME-PTR NOT = NULL
               FREE BOOK-CLAIMS-NAME-PTR
           END-IF.
           SET BOOK-CLAIMS-NAME-PTR TO NULL.
           MOVE 0 TO BOOK-CLAIMS-NAME-CAP.
           MOVE 0 TO BOOK-CLAIMS-OPEN-ITEMS.
           MOVE 0 TO BOOK-CLAIMS-CLOSED-ITEMS.
           MOVE 0 TO SUFFIX-LEN.
           IF SUFFIX-PTR NOT = NULL
               FREE SUFFIX-PTR
           END-IF.
           SET SUFFIX-PTR TO NULL.
           MOVE 0 TO SUFFIX-CAP.
           MOVE 0 TO NOTE-LEN.
           IF NOTE-PTR NOT = NULL
               FREE NOTE-PTR
           END-IF.
           SET NOTE-PTR TO NULL.
           MOVE 0 TO NOTE-CAP.
           MOVE 0 TO TITLE-LEN.
           IF TITLE-PTR NOT = NULL
               FREE TITLE-PTR
           END-IF.
           SET TITLE-PTR TO NULL.
           MOVE 0 TO TITLE-CAP.
           GOBACK.
       CBLC-EX-CLEAR-PAYLOAD.
           EXIT.

           GOBACK.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-LOAD.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT = LEDGER-LOAD-POLICIES.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-CLAIM-COUNT = LEDGER-LOAD-CLAIMS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT = LEDGER-LOAD-INVESTIGATIONS.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-PAID-CLAIMS = LEDGER-LOAD-PAID.
           COMPUTE SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHTED-SCORE = SHOWCASE-PORTFOLIO-RISK-REVIEW-POLICY-COUNT / 250 + SHOWCASE-PORTFOLIO-RISK-REVIEW-WEIGHT-SEED - SHOWCASE-PORTFOLIO-RISK-REVIEW-INVESTIGATION-COUNT.
           EXIT.

       CBLC-METHOD-SHOWCASE-PORTFOLIO-RISK-REVIEW-PRINT-HEADER.
