void F(char *destination_char, int destination_length, char *source_char, int source_length, int status)
{
    int index;
    int source_limit;
    int destination_limit;
    status = 0;
    source_limit = source_length;
    destination_limit = destination_length;
    if (source_limit > 255)
    {
        source_limit = 255;
        status = 1;
    }
    if (destination_limit > 255)
    {
        destination_limit = 255;
    }
    index = 0;
    while (index < destination_limit)
    {
        destination_char[index] = ' ';
        index = index + 1;
    }
    index = 0;
    while (index < source_limit)
    {
        if (index >= destination_limit)
        {
            status = 1;
            index = source_limit;
        }
        else
        {
            destination_char[index] = source_char[index];
            index = index + 1;
        }
    }
}
