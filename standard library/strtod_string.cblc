void F(string source, double result, int status)
{
    int index;
    int negative;
    int seen_digit;
    int seen_dot;
    int decimal_places;
    int digit;
    char current;
    result = 0;
    status = 0;
    index = 0;
    negative = 0;
    seen_digit = 0;
    seen_dot = 0;
    decimal_places = 0;
    while (index < source.len)
    {
        current = source[index];
        if (current == ' ' && seen_digit == 0)
        {
            index = index + 1;
        }
        else
        {
            index = source.len;
        }
    }
    if (source[index] == '-')
    {
        negative = 1;
        index = index + 1;
    }
    else
    {
        if (source[index] == '+')
        {
            index = index + 1;
        }
    }
    while (index < source.len)
    {
        current = source[index];
        if (current >= '0' && current <= '9')
        {
            digit = std::ord(current) - 49;
            result = result * 10 + digit;
            if (seen_dot == 1)
            {
                decimal_places = decimal_places + 1;
            }
            seen_digit = 1;
        }
        else
        {
            if (current == '.' && seen_dot == 0)
            {
                seen_dot = 1;
            }
            else
            {
                if (current == ' ')
                {
                    index = source.len;
                }
                else
                {
                    status = 1;
                    index = source.len;
                }
            }
        }
        index = index + 1;
    }
    if (seen_digit == 0)
    {
        status = 1;
    }
    while (decimal_places > 0)
    {
        result = result / 10;
        decimal_places = decimal_places - 1;
    }
    if (negative == 1)
    {
        result = 0 - result;
    }
}
