class string
{
    private:
    char *data;
    int stored_length;
    int storage_capacity;

    int is_valid_utf8_bytes(char *source, int source_length)
    {
        int index;
        int first;
        int second;
        int remaining;
        int width;
        int second_minimum;
        int second_maximum;
        int continuation_index;
        int continuation_end;
        int second_index;
        int continuation;
        char current;

        if (source_length < 0)
        {
            return 0;
        }
        if (source == NULL && source_length > 0)
        {
            return 0;
        }
        index = 0;
        while (index < source_length)
        {
            current = source[index];
            first = std::ord(current) - 1;
            remaining = source_length - index;
            width = 0;
            second_minimum = 128;
            second_maximum = 191;
            if (first <= 127)
            {
                width = 1;
            }
            else
            {
                if (first >= 194 && first <= 223)
                {
                    width = 2;
                }
                else
                {
                    if (first >= 224 && first <= 239)
                    {
                        width = 3;
                        if (first == 224)
                        {
                            second_minimum = 160;
                        }
                        if (first == 237)
                        {
                            second_maximum = 159;
                        }
                    }
                    else
                    {
                        if (first >= 240 && first <= 244)
                        {
                            width = 4;
                            if (first == 240)
                            {
                                second_minimum = 144;
                            }
                            if (first == 244)
                            {
                                second_maximum = 143;
                            }
                        }
                    }
                }
            }
            if (width == 0)
            {
                return 0;
            }
            if (remaining < width)
            {
                return 0;
            }
            continuation_index = index + 1;
            continuation_end = index + width;
            second_index = index + 1;
            while (continuation_index < continuation_end)
            {
                current = source[continuation_index];
                continuation = std::ord(current) - 1;
                if (continuation < 128)
                {
                    return 0;
                }
                if (continuation > 191)
                {
                    return 0;
                }
                if (continuation_index == second_index)
                {
                    second = continuation;
                    if (second < second_minimum)
                    {
                        return 0;
                    }
                    if (second > second_maximum)
                    {
                        return 0;
                    }
                }
                continuation_index = continuation_index + 1;
            }
            index = index + width;
        }
        return 1;
    }

    int is_ascii_whitespace_byte(int byte_value)
    {
        if (byte_value == 32)
        {
            return 1;
        }
        if (byte_value == 9)
        {
            return 1;
        }
        if (byte_value == 10)
        {
            return 1;
        }
        if (byte_value == 13)
        {
            return 1;
        }
        if (byte_value == 12)
        {
            return 1;
        }
        if (byte_value == 11)
        {
            return 1;
        }
        return 0;
    }

    void reserve_storage(int requested_capacity)
    {
        int new_capacity;
        int index;
        char *replacement;
        if (requested_capacity < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested_capacity > 999999999)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        if (requested_capacity <= storage_capacity)
        {
            return;
        }
        new_capacity = storage_capacity;
        if (new_capacity < 1)
        {
            new_capacity = 1;
        }
        while (new_capacity < requested_capacity)
        {
            if (new_capacity > 499999999)
            {
                new_capacity = requested_capacity;
            }
            else
            {
                new_capacity = new_capacity * 2;
            }
        }
        replacement = new char[new_capacity];
        index = 0;
        while (index < stored_length)
        {
            replacement[index] = data[index];
            index = index + 1;
        }
        replacement[stored_length] = '\0';
        delete[] data;
        data = replacement;
        storage_capacity = new_capacity;
    }

    public:
    string()
    {
        data = new char[1];
        stored_length = 0;
        storage_capacity = 1;
        data[0] = '\0';
    }

    string(int requested_capacity)
    {
        if (requested_capacity < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested_capacity > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        storage_capacity = requested_capacity + 1;
        data = new char[storage_capacity];
        stored_length = 0;
        data[0] = '\0';
    }

    string(char *source)
    {
        int index;
        int source_length;
        int valid_encoding;

        data = NULL;
        stored_length = 0;
        storage_capacity = 0;
        if (source == NULL)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        source_length = 0;
        while (source[source_length] != '\0')
        {
            if (source_length >= 999999998)
            {
                length_error error;
                error.code = 1;
                throw error;
            }
            source_length = source_length + 1;
        }
        valid_encoding = is_valid_utf8_bytes(source, source_length);
        if (valid_encoding == 0)
        {
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        storage_capacity = source_length + 1;
        data = new char[storage_capacity];
        index = 0;
        while (index < source_length)
        {
            data[index] = source[index];
            index = index + 1;
        }
        stored_length = source_length;
        data[stored_length] = '\0';
    }

    string(char *source, int source_length)
    {
        int index;
        int valid_encoding;
        data = NULL;
        stored_length = 0;
        storage_capacity = 0;
        if (source_length < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (source == NULL && source_length > 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (source_length > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        valid_encoding = is_valid_utf8_bytes(source, source_length);
        if (valid_encoding == 0)
        {
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        storage_capacity = source_length + 1;
        data = new char[storage_capacity];
        stored_length = source_length;
        index = 0;
        while (index < stored_length)
        {
            data[index] = source[index];
            index = index + 1;
        }
        data[stored_length] = '\0';
    }

    string(string source)
    {
        int index;
        stored_length = source.stored_length;
        storage_capacity = stored_length + 1;
        data = new char[storage_capacity];
        index = 0;
        while (index < stored_length)
        {
            data[index] = source.data[index];
            index = index + 1;
        }
        data[stored_length] = '\0';
    }

    string(string *source)
    {
        if (source == NULL)
        {
            data = new char[1];
            stored_length = 0;
            storage_capacity = 1;
            data[0] = '\0';
        }
        else
        {
            data = source->data;
            stored_length = source->stored_length;
            storage_capacity = source->storage_capacity;
            source->data = NULL;
            source->stored_length = 0;
            source->storage_capacity = 0;
        }
    }

    ~string()
    {
        delete[] data;
    }

    void operator=(string source)
    {
        char *old_data;
        int old_length;
        int old_capacity;

        old_data = data;
        data = source.data;
        source.data = old_data;
        old_length = stored_length;
        stored_length = source.stored_length;
        source.stored_length = old_length;
        old_capacity = storage_capacity;
        storage_capacity = source.storage_capacity;
        source.storage_capacity = old_capacity;
    }

    void swap(string *other)
    {
        char *temporary_data;
        int temporary_length;
        int temporary_capacity;

        if (other == NULL)
        {
            return;
        }
        temporary_data = data;
        data = other->data;
        other->data = temporary_data;
        temporary_length = stored_length;
        stored_length = other->stored_length;
        other->stored_length = temporary_length;
        temporary_capacity = storage_capacity;
        storage_capacity = other->storage_capacity;
        other->storage_capacity = temporary_capacity;
    }

    void move_from(string *source)
    {
        if (source == NULL || source->data == data)
        {
            return;
        }
        delete[] data;
        data = source->data;
        stored_length = source->stored_length;
        storage_capacity = source->storage_capacity;
        source->data = NULL;
        source->stored_length = 0;
        source->storage_capacity = 0;
    }

    void move_assign(string *source)
    {
        if (source == NULL || source->data == data)
        {
            return;
        }
        delete[] data;
        data = source->data;
        stored_length = source->stored_length;
        storage_capacity = source->storage_capacity;
        source->data = NULL;
        source->stored_length = 0;
        source->storage_capacity = 0;
    }

    int len()
    {
        return stored_length;
    }

    int is_valid_utf8()
    {
        int valid_encoding;

        if (stored_length < 0 || storage_capacity < 0)
        {
            return 0;
        }
        if (data == NULL)
        {
            if (stored_length == 0 && storage_capacity == 0)
            {
                return 1;
            }
            return 0;
        }
        if (storage_capacity <= stored_length)
        {
            return 0;
        }
        if (data[stored_length] != '\0')
        {
            return 0;
        }
        valid_encoding = is_valid_utf8_bytes(data, stored_length);
        return valid_encoding;
    }

    int codepoint_length()
    {
        int index;
        int count;
        int current;

        index = 0;
        count = 0;
        while (index < stored_length)
        {
            current = std::ord(data[index]) - 1;
            if (current < 128)
            {
                count = count + 1;
            }
            else
            {
                if (current > 191)
                {
                    count = count + 1;
                }
            }
            index = index + 1;
        }
        return count;
    }

    int encode_codepoint(int scalar, char *encoded)
    {
        int scalar_div_64;
        int scalar_div_4096;
        int scalar_div_262144;
        int remainder;
        int byte_value;

        if (scalar < 0)
        {
            invalid_encoding error;
            error.code = 2;
            throw error;
        }
        if (scalar > 1114111)
        {
            invalid_encoding error;
            error.code = 2;
            throw error;
        }
        if (scalar >= 55296)
        {
            if (scalar <= 57343)
            {
                invalid_encoding error;
                error.code = 2;
                throw error;
            }
        }
        if (scalar <= 127)
        {
            encoded[0] = std::chr(scalar);
            return 1;
        }
        if (scalar <= 2047)
        {
            scalar_div_64 = scalar / 64;
            byte_value = scalar_div_64 + 192;
            encoded[0] = std::chr(byte_value);
            remainder = scalar_div_64 * 64;
            remainder = scalar - remainder;
            byte_value = remainder + 128;
            encoded[1] = std::chr(byte_value);
            return 2;
        }
        if (scalar <= 65535)
        {
            scalar_div_4096 = scalar / 4096;
            byte_value = scalar_div_4096 + 224;
            encoded[0] = std::chr(byte_value);
            scalar_div_64 = scalar / 64;
            remainder = scalar_div_4096 * 64;
            byte_value = scalar_div_64 - remainder;
            byte_value = byte_value + 128;
            encoded[1] = std::chr(byte_value);
            remainder = scalar_div_64 * 64;
            remainder = scalar - remainder;
            byte_value = remainder + 128;
            encoded[2] = std::chr(byte_value);
            return 3;
        }
        scalar_div_262144 = scalar / 262144;
        byte_value = scalar_div_262144 + 240;
        encoded[0] = std::chr(byte_value);
        scalar_div_4096 = scalar / 4096;
        remainder = scalar_div_262144 * 64;
        byte_value = scalar_div_4096 - remainder;
        byte_value = byte_value + 128;
        encoded[1] = std::chr(byte_value);
        scalar_div_64 = scalar / 64;
        remainder = scalar_div_4096 * 64;
        byte_value = scalar_div_64 - remainder;
        byte_value = byte_value + 128;
        encoded[2] = std::chr(byte_value);
        remainder = scalar_div_64 * 64;
        remainder = scalar - remainder;
        byte_value = remainder + 128;
        encoded[3] = std::chr(byte_value);
        return 4;
    }

    int codepoint_at(int character_index)
    {
        int byte_index;
        int current_index;
        int first;
        int second;
        int third;
        int fourth;
        int result;

        if (character_index < 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        byte_index = 0;
        current_index = 0;
        while (current_index < character_index && byte_index < stored_length)
        {
            first = std::ord(data[byte_index]) - 1;
            if (first < 128)
            {
                byte_index = byte_index + 1;
            }
            else
            {
                if (first < 224)
                {
                    byte_index = byte_index + 2;
                }
                else
                {
                    if (first < 240)
                    {
                        byte_index = byte_index + 3;
                    }
                    else
                    {
                        byte_index = byte_index + 4;
                    }
                }
            }
            current_index = current_index + 1;
        }
        if (byte_index >= stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        first = std::ord(data[byte_index]) - 1;
        if (first < 128)
        {
            result = first;
        }
        else
        {
            if (first < 224)
            {
                second = std::ord(data[byte_index + 1]) - 1;
                result = first - 192;
                result = result * 64;
                result = result + second;
                result = result - 128;
            }
            else
            {
                if (first < 240)
                {
                    second = std::ord(data[byte_index + 1]) - 1;
                    third = std::ord(data[byte_index + 2]) - 1;
                    result = first - 224;
                    result = result * 64;
                    result = result + second;
                    result = result - 128;
                    result = result * 64;
                    result = result + third;
                    result = result - 128;
                }
                else
                {
                    second = std::ord(data[byte_index + 1]) - 1;
                    third = std::ord(data[byte_index + 2]) - 1;
                    fourth = std::ord(data[byte_index + 3]) - 1;
                    result = first - 240;
                    result = result * 64;
                    result = result + second;
                    result = result - 128;
                    result = result * 64;
                    result = result + third;
                    result = result - 128;
                    result = result * 64;
                    result = result + fourth;
                    result = result - 128;
                }
            }
        }
        return result;
    }

    void set_byte(int byte_index, char replacement_byte)
    {
        char *replacement;
        int index;
        int valid_encoding;

        if (byte_index < 0 || byte_index >= stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        replacement = new char[stored_length + 1];
        index = 0;
        while (index < stored_length)
        {
            if (index == byte_index)
            {
                replacement[index] = replacement_byte;
            }
            else
            {
                replacement[index] = data[index];
            }
            index = index + 1;
        }
        replacement[stored_length] = '\0';
        valid_encoding = is_valid_utf8_bytes(replacement, stored_length);
        if (valid_encoding == 0)
        {
            delete[] replacement;
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        if (data != NULL)
        {
            delete[] data;
        }
        data = replacement;
        storage_capacity = stored_length + 1;
    }

    int byte_length()
    {
        return stored_length;
    }

    char *to_c_string()
    {
        char *result;
        int index;

        index = 0;
        while (index < stored_length)
        {
            if (data[index] == '\0')
            {
                invalid_argument error;
                error.code = 2;
                throw error;
            }
            index = index + 1;
        }
        result = new char[stored_length + 1];
        index = 0;
        while (index < stored_length)
        {
            result[index] = data[index];
            index = index + 1;
        }
        result[stored_length] = '\0';
        return result;
    }

    int copy_to(char *destination, int destination_capacity)
    {
        int index;

        if (destination_capacity < 0
            || (destination == NULL && stored_length > 0))
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (destination_capacity < stored_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        if (destination == data)
        {
            return stored_length;
        }
        index = 0;
        while (index < stored_length)
        {
            destination[index] = data[index];
            index = index + 1;
        }
        return stored_length;
    }

    string substr(int byte_position, int byte_count)
    {
        int end_position;
        int byte_value;
        int index;

        if (byte_position < 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_position > stored_length)
        {
            out_of_range error;
            error.code = 2;
            throw error;
        }
        if (byte_count < 0)
        {
            out_of_range error;
            error.code = 3;
            throw error;
        }
        if (byte_count > stored_length - byte_position)
        {
            out_of_range error;
            error.code = 4;
            throw error;
        }
        end_position = byte_position + byte_count;
        if (byte_position > 0 && byte_position < stored_length)
        {
            byte_value = std::ord(data[byte_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        if (end_position > 0 && end_position < stored_length)
        {
            byte_value = std::ord(data[end_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 2;
                throw error;
            }
        }
        {
            string result;

            result.reserve_storage(byte_count + 1);
            index = 0;
            while (index < byte_count)
            {
                result.data[index] = data[byte_position + index];
                index = index + 1;
            }
            result.data[byte_count] = '\0';
            result.stored_length = byte_count;
            return result;
        }
    }

    int capacity()
    {
        if (storage_capacity <= 0)
        {
            return 0;
        }
        return storage_capacity - 1;
    }

    void reserve(int requested_capacity)
    {
        if (requested_capacity < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested_capacity > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        reserve_storage(requested_capacity + 1);
    }

    void shrink_to_fit()
    {
        int requested_capacity;
        int index;
        char *replacement;

        requested_capacity = stored_length + 1;
        if (data != NULL && storage_capacity <= requested_capacity)
        {
            return;
        }
        replacement = new char[requested_capacity];
        index = 0;
        while (index < stored_length)
        {
            replacement[index] = data[index];
            index = index + 1;
        }
        replacement[stored_length] = '\0';
        delete[] data;
        data = replacement;
        storage_capacity = requested_capacity;
    }

    int max_size()
    {
        return 999999998;
    }

    int empty()
    {
        if (stored_length == 0)
        {
            return 1;
        }
        return 0;
    }

    void clear()
    {
        stored_length = 0;
        if (data != NULL)
        {
            data[0] = '\0';
        }
    }

    void resize(int requested)
    {
        int index;
        char boundary;

        if (requested < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        if (requested < stored_length)
        {
            if (requested > 0)
            {
                boundary = data[requested];
                if (std::ord(boundary) - 1 >= 128)
                {
                    if (std::ord(boundary) - 1 <= 191)
                    {
                        invalid_argument error;
                        error.code = 2;
                        throw error;
                    }
                }
            }
            stored_length = requested;
            data[stored_length] = '\0';
            return;
        }
        if (requested == stored_length)
        {
            return;
        }
        reserve_storage(requested + 1);
        index = stored_length;
        while (index < requested)
        {
            data[index] = '\0';
            index = index + 1;
        }
        stored_length = requested;
        data[stored_length] = '\0';
    }

    void resize(int requested, char fill)
    {
        int index;
        int fill_value;
        char boundary;

        if (requested < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        if (requested < stored_length)
        {
            if (requested > 0)
            {
                boundary = data[requested];
                fill_value = std::ord(boundary) - 1;
                if (fill_value >= 128)
                {
                    if (fill_value <= 191)
                    {
                        invalid_argument error;
                        error.code = 2;
                        throw error;
                    }
                }
            }
            stored_length = requested;
            data[stored_length] = '\0';
            return;
        }
        if (requested == stored_length)
        {
            return;
        }
        fill_value = std::ord(fill) - 1;
        if (fill_value > 127)
        {
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        reserve_storage(requested + 1);
        index = stored_length;
        while (index < requested)
        {
            data[index] = fill;
            index = index + 1;
        }
        stored_length = requested;
        data[stored_length] = '\0';
    }

    void push_back(char value)
    {
        int byte_value;

        if (stored_length >= 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        byte_value = std::ord(value) - 1;
        if (byte_value > 127)
        {
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        reserve_storage(stored_length + 2);
        data[stored_length] = value;
        stored_length = stored_length + 1;
        data[stored_length] = '\0';
    }

    void push_codepoint(int scalar)
    {
        char encoded[4];
        int encoded_length;
        int new_length;
        int index;

        encoded_length = encode_codepoint(scalar, encoded);
        if (encoded_length > 999999998 - stored_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        new_length = stored_length + encoded_length;
        reserve_storage(new_length + 1);
        index = 0;
        while (index < encoded_length)
        {
            data[stored_length + index] = encoded[index];
            index = index + 1;
        }
        stored_length = new_length;
        data[stored_length] = '\0';
    }

    void set_codepoint(int character_index, int scalar)
    {
        int byte_index;
        int current_index;
        int first;
        int old_width;
        int replacement_length;
        int encoded_length;
        int source_index;
        int target_index;
        char encoded[4];
        char *replacement;

        if (character_index < 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        byte_index = 0;
        current_index = 0;
        while (current_index < character_index && byte_index < stored_length)
        {
            first = std::ord(data[byte_index]) - 1;
            if (first < 128)
            {
                byte_index = byte_index + 1;
            }
            else
            {
                if (first < 224)
                {
                    byte_index = byte_index + 2;
                }
                else
                {
                    if (first < 240)
                    {
                        byte_index = byte_index + 3;
                    }
                    else
                    {
                        byte_index = byte_index + 4;
                    }
                }
            }
            current_index = current_index + 1;
        }
        if (byte_index >= stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        encoded_length = encode_codepoint(scalar, encoded);
        first = std::ord(data[byte_index]) - 1;
        if (first < 128)
        {
            old_width = 1;
        }
        else
        {
            if (first < 224)
            {
                old_width = 2;
            }
            else
            {
                if (first < 240)
                {
                    old_width = 3;
                }
                else
                {
                    old_width = 4;
                }
            }
        }
        replacement_length = stored_length - old_width + encoded_length;
        if (replacement_length > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        replacement = new char[replacement_length + 1];
        source_index = 0;
        target_index = 0;
        while (source_index < byte_index)
        {
            replacement[target_index] = data[source_index];
            source_index = source_index + 1;
            target_index = target_index + 1;
        }
        source_index = 0;
        while (source_index < encoded_length)
        {
            replacement[target_index] = encoded[source_index];
            source_index = source_index + 1;
            target_index = target_index + 1;
        }
        source_index = byte_index + old_width;
        while (source_index < stored_length)
        {
            replacement[target_index] = data[source_index];
            source_index = source_index + 1;
            target_index = target_index + 1;
        }
        replacement[replacement_length] = '\0';
        delete[] data;
        data = replacement;
        stored_length = replacement_length;
        storage_capacity = replacement_length + 1;
    }

    void pop_back()
    {
        int index;
        int byte_value;
        char current;

        if (stored_length <= 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        index = stored_length - 1;
        current = data[index];
        byte_value = std::ord(current) - 1;
        while (index > 0 && byte_value >= 128 && byte_value <= 191)
        {
            index = index - 1;
            current = data[index];
            byte_value = std::ord(current) - 1;
        }
        stored_length = index;
        data[stored_length] = '\0';
    }

    void append(string source)
    {
        int old_length;
        int index;
        int source_length;
        char current;
        old_length = stored_length;
        source_length = source.stored_length;
        if (source_length > 999999998 - old_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        reserve_storage(stored_length + source_length + 1);
        index = 0;
        while (index < source_length)
        {
            current = source.data[index];
            data[old_length + index] = current;
            index = index + 1;
        }
        stored_length = old_length + source_length;
        data[stored_length] = '\0';
    }

    void operator+=(string source)
    {
        append(source);
    }

    string operator+(string source)
    {
        string result;
        int result_length;
        int source_length;
        int index;

        source_length = source.stored_length;
        if (source_length > 999999998 - stored_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        result_length = stored_length + source_length;
        result.data = new char[result_length + 1];
        result.storage_capacity = result_length + 1;
        index = 0;
        while (index < stored_length)
        {
            result.data[index] = data[index];
            index = index + 1;
        }
        index = 0;
        while (index < source_length)
        {
            result.data[stored_length + index] = source.data[index];
            index = index + 1;
        }
        result.stored_length = result_length;
        result.data[result_length] = '\0';
        return result;
    }

