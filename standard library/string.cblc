    void assign(char *source, int source_length)
    {
        int index;
        int valid_encoding;
        char *replacement;

        if (source_length < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (source == NULL && source_length > 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (source_length > 999999998)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        valid_encoding = is_valid_utf8_bytes(source, source_length);
        if (valid_encoding == 0)
        {
            invalid_encoding error;
            error.code = 1;
            throw error;
        }
        replacement = new char[source_length + 1];
        index = 0;
        while (index < source_length)
        {
            replacement[index] = source[index];
            index = index + 1;
        }
        replacement[source_length] = '\0';
        delete[] data;
        data = replacement;
        stored_length = source_length;
        storage_capacity = source_length + 1;
    }

    void insert(int byte_position, string source)
    {
        int source_length;
        int result_length;
        int index;
        int byte_value;
        char *replacement;

        if (byte_position < 0 || byte_position > stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_position > 0 && byte_position < stored_length)
        {
            byte_value = std::ord(data[byte_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        source_length = source.stored_length;
        if (source_length == 0)
        {
            return;
        }
        if (source_length > 999999998 - stored_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        result_length = stored_length + source_length;
        replacement = new char[result_length + 1];
