    void erase(int byte_position, int byte_count)
    {
        int source_index;
        int target_index;
        int new_length;
        int end_position;
        int byte_value;

        if (byte_position < 0 || byte_position > stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_count < 0 || byte_count > stored_length - byte_position)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_position > 0 && byte_position < stored_length)
        {
            byte_value = std::ord(data[byte_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        end_position = byte_position + byte_count;
        if (end_position > 0 && end_position < stored_length)
        {
            byte_value = std::ord(data[end_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        if (byte_count == 0)
        {
            return;
        }
        source_index = end_position;
        target_index = byte_position;
        while (source_index < stored_length)
        {
            data[target_index] = data[source_index];
            source_index = source_index + 1;
            target_index = target_index + 1;
        }
        new_length = stored_length - byte_count;
        data[new_length] = '\0';
        stored_length = new_length;
    }

    void replace(int byte_position, int byte_count, string source)
    {
        int source_length;
        int retained_length;
        int result_length;
        int suffix_index;
        int target_index;
        int copy_index;
        int end_position;
        int byte_value;
        char *replacement;

        if (byte_position < 0 || byte_position > stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_count < 0 || byte_count > stored_length - byte_position)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_position > 0 && byte_position < stored_length)
        {
            byte_value = std::ord(data[byte_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        end_position = byte_position + byte_count;
        if (end_position > 0 && end_position < stored_length)
        {
            byte_value = std::ord(data[end_position]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        source_length = source.stored_length;
        retained_length = stored_length - byte_count;
        if (byte_count == 0 && source_length == 0)
        {
            return;
        }
        if (source_length > 999999998 - retained_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        result_length = retained_length + source_length;
        replacement = new char[result_length + 1];
        copy_index = 0;
        while (copy_index < byte_position)
        {
            replacement[copy_index] = data[copy_index];
            copy_index = copy_index + 1;
        }
        copy_index = 0;
        while (copy_index < source_length)
        {
            replacement[byte_position + copy_index] = source.data[copy_index];
            copy_index = copy_index + 1;
        }
        suffix_index = end_position;
        target_index = byte_position + source_length;
        while (suffix_index < stored_length)
        {
            replacement[target_index] = data[suffix_index];
            suffix_index = suffix_index + 1;
            target_index = target_index + 1;
        }
        replacement[result_length] = '\0';
        delete[] data;
        data = replacement;
        stored_length = result_length;
        storage_capacity = result_length + 1;
    }

    void replace_all(string old_text, string new_text)
    {
        int old_length;
        int new_length;
        int search_index;
        int probe_index;
        int match_index;
        int matched;
        int replacement_count;
        int growth_per_match;
        int available_growth;
        int result_length;
        int read_index;
        int write_index;
        int source_index;
        char input_byte;
        char pattern_byte;
        char *replacement;

        old_length = old_text.stored_length;
        new_length = new_text.stored_length;
        if (old_length == 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        replacement_count = 0;
        search_index = 0;
        while (search_index <= stored_length - old_length)
        {
            matched = 1;
            match_index = 0;
            probe_index = search_index;
            while (match_index < old_length && matched == 1)
            {
                input_byte = data[probe_index];
                pattern_byte = old_text.data[match_index];
                if (input_byte != pattern_byte)
                {
                    matched = 0;
                }
                else
                {
                    probe_index = probe_index + 1;
                    match_index = match_index + 1;
                }
            }
            if (matched == 1)
            {
                replacement_count = replacement_count + 1;
                search_index = search_index + old_length;
            }
            else
            {
                search_index = search_index + 1;
            }
        }
        if (replacement_count == 0)
        {
            return;
        }
        result_length = stored_length;
        if (new_length > old_length)
        {
            growth_per_match = new_length - old_length;
            available_growth = 999999998 - stored_length;
            if (replacement_count > available_growth / growth_per_match)
            {
                length_error error;
                error.code = 1;
                throw error;
            }
            result_length = stored_length + replacement_count * growth_per_match;
        }
        else
        {
            if (new_length < old_length)
            {
                growth_per_match = old_length - new_length;
                result_length = stored_length - replacement_count * growth_per_match;
            }
        }
        replacement = new char[result_length + 1];
        read_index = 0;
        write_index = 0;
        while (read_index < stored_length)
        {
            matched = 0;
            if (read_index <= stored_length - old_length)
            {
                matched = 1;
                match_index = 0;
                probe_index = read_index;
                while (match_index < old_length && matched == 1)
                {
                    input_byte = data[probe_index];
                    pattern_byte = old_text.data[match_index];
                    if (input_byte != pattern_byte)
                    {
                        matched = 0;
                    }
                    else
                    {
                        probe_index = probe_index + 1;
                        match_index = match_index + 1;
                    }
                }
            }
            if (matched == 1)
            {
                source_index = 0;
                while (source_index < new_length)
                {
                    replacement[write_index] = new_text.data[source_index];
                    write_index = write_index + 1;
                    source_index = source_index + 1;
                }
                read_index = read_index + old_length;
            }
            else
            {
                replacement[write_index] = data[read_index];
                write_index = write_index + 1;
                read_index = read_index + 1;
            }
        }
        replacement[result_length] = '\0';
        delete[] data;
        data = replacement;
        stored_length = result_length;
        storage_capacity = result_length + 1;
    }

    void remove_prefix(int byte_count)
    {
        int byte_value;
        int source_index;
        int target_index;

        if (byte_count < 0 || byte_count > stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_count == 0)
        {
            return;
        }
        if (byte_count < stored_length)
        {
            byte_value = std::ord(data[byte_count]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        source_index = byte_count;
        target_index = 0;
        while (source_index < stored_length)
        {
            data[target_index] = data[source_index];
            source_index = source_index + 1;
            target_index = target_index + 1;
        }
        stored_length = stored_length - byte_count;
        data[stored_length] = '\0';
    }

    void remove_suffix(int byte_count)
    {
        int new_length;
        int byte_value;

        if (byte_count < 0 || byte_count > stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (byte_count == 0)
        {
            return;
        }
        new_length = stored_length - byte_count;
        if (new_length > 0)
        {
            byte_value = std::ord(data[new_length]) - 1;
            if (byte_value >= 128 && byte_value <= 191)
            {
                invalid_argument error;
                error.code = 1;
                throw error;
            }
        }
        data[new_length] = '\0';
        stored_length = new_length;
    }

    int equals(string source)
    {
        int index;
        int source_length;
        char current;
        source_length = source.stored_length;
        if (stored_length != source_length)
        {
            return 0;
        }
        index = 0;
        while (index < stored_length)
        {
            current = source.data[index];
            if (data[index] != current)
            {
                return 0;
            }
            index = index + 1;
        }
        return 1;
    }

    int equals_ignore_case_ascii(string source)
    {
        int index;
        int left_byte;
        int right_byte;
        int source_length;

        source_length = source.stored_length;
        if (stored_length != source_length)
        {
            return 0;
        }
        index = 0;
        while (index < stored_length)
        {
            left_byte = std::ord(data[index]) - 1;
            right_byte = std::ord(source.data[index]) - 1;
            if (left_byte >= 65 && left_byte <= 90)
            {
                left_byte = left_byte + 32;
            }
            if (right_byte >= 65 && right_byte <= 90)
            {
                right_byte = right_byte + 32;
            }
            if (left_byte != right_byte)
            {
                return 0;
            }
            index = index + 1;
        }
        return 1;
    }

    void trim_start_ascii()
    {
        int byte_value;
        int is_trimming;
        int is_whitespace;
        int source_index;
        int target_index;
        char current;

        source_index = 0;
        is_trimming = 1;
        while (source_index < stored_length && is_trimming == 1)
        {
            current = data[source_index];
            byte_value = std::ord(current) - 1;
            is_whitespace = is_ascii_whitespace_byte(byte_value);
            if (is_whitespace == 1)
            {
                source_index = source_index + 1;
            }
            else
            {
                is_trimming = 0;
            }
        }
        if (source_index == 0)
        {
            return;
        }
        target_index = 0;
        while (source_index < stored_length)
        {
            data[target_index] = data[source_index];
            target_index = target_index + 1;
            source_index = source_index + 1;
        }
        stored_length = target_index;
        data[stored_length] = '\0';
    }

    void trim_end_ascii()
    {
        int byte_value;
        int is_trimming;
        int is_whitespace;
        int new_length;
        char current;

        if (data == NULL)
        {
            return;
        }
        new_length = stored_length;
        is_trimming = 1;
        while (new_length > 0 && is_trimming == 1)
        {
            current = data[new_length - 1];
            byte_value = std::ord(current) - 1;
            is_whitespace = is_ascii_whitespace_byte(byte_value);
            if (is_whitespace == 1)
            {
                new_length = new_length - 1;
            }
            else
            {
                is_trimming = 0;
            }
        }
        stored_length = new_length;
        data[stored_length] = '\0';
    }

    void trim_ascii()
    {
        trim_start_ascii();
        trim_end_ascii();
    }

    int starts_with(string source)
    {
        int index;
        int source_length;
        char current;
        source_length = source.stored_length;
        if (source_length > stored_length)
        {
            return 0;
        }
        index = 0;
        while (index < source_length)
        {
            current = source.data[index];
            if (data[index] != current)
            {
                return 0;
            }
            index = index + 1;
        }
        return 1;
    }

    int ends_with(string source)
    {
        int index;
        int offset;
        int source_length;
        char current;
        source_length = source.stored_length;
        if (source_length > stored_length)
        {
            return 0;
        }
        index = 0;
        offset = stored_length - source_length;
        while (index < source_length)
        {
            current = source.data[index];
            if (data[offset + index] != current)
            {
                return 0;
            }
            index = index + 1;
        }
        return 1;
    }

    int compare(string source)
    {
        int index;
        int limit;
        int result;
        int source_length;
        int left_byte;
        int right_byte;
        result = 0;
        index = 0;
        limit = stored_length;
        source_length = source.stored_length;
        if (source_length < limit)
        {
            limit = source_length;
        }
        while (index < limit)
        {
            left_byte = std::ord(data[index]) - 1;
            right_byte = std::ord(source.data[index]) - 1;
            if (left_byte < right_byte)
            {
                result = -1;
                index = limit;
            }
            else
            {
                if (left_byte > right_byte)
                {
                    result = 1;
                    index = limit;
                }
                else
                {
                    index = index + 1;
                }
            }
        }
        if (result == 0)
        {
            if (stored_length < source_length)
            {
                result = -1;
            }
            else
            {
                if (stored_length > source_length)
                {
                    result = 1;
                }
            }
        }
        return result;
    }

    int contains(string source)
    {
        int start;
        int index;
        int matched;
        int source_length;
        char current;
        source_length = source.stored_length;
        if (source_length == 0)
        {
            return 1;
        }
        start = 0;
        while (start <= stored_length - source_length)
        {
            index = 0;
            matched = 1;
            while (index < source_length)
            {
                current = source.data[index];
                if (data[start + index] != current)
                {
                    matched = 0;
                    index = source_length;
                }
                else
                {
                    index = index + 1;
                }
            }
            if (matched == 1)
            {
                return 1;
            }
            start = start + 1;
        }
        return 0;
    }

    int parse_int()
    {
        int result;
        int index;
        int end;
        int negative;
        int digit;
        int maximum_magnitude;
        char current;

        index = 0;
        end = stored_length;
        while (index < end
            && is_ascii_whitespace_byte(std::ord(data[index]) - 1) == 1)
        {
            index = index + 1;
        }
        while (end > index
            && is_ascii_whitespace_byte(std::ord(data[end - 1]) - 1) == 1)
        {
            end = end - 1;
        }
        negative = 0;
        if (index < end && data[index] == '-')
        {
            negative = 1;
            index = index + 1;
        }
        else
        {
            if (index < end && data[index] == '+')
            {
                index = index + 1;
            }
        }
        if (index >= end)
        {
            parse_error error;
            error.code = 1;
            throw error;
        }

        result = 0;
        maximum_magnitude = 999999999;
        while (index < end)
        {
            current = data[index];
            digit = std::ord(current) - std::ord('0');
            if (digit < 0 || digit > 9)
            {
                parse_error error;
                error.code = 2;
                throw error;
            }
            if (result > (maximum_magnitude - digit) / 10)
            {
                range_error error;
                error.code = 1;
                throw error;
            }
            result = result * 10 + digit;
            index = index + 1;
        }
        if (negative == 1)
        {
            result = 0 - result;
        }
        return result;
    }

    int atoi()
    {
        int result;
        result = parse_int();
        return result;
    }

    int atol()
    {
        int result;
        result = parse_int();
        return result;
    }

    int atoll()
    {
        int result;
        result = parse_int();
        return result;
    }

    int strlen()
    {
        return stored_length;
    }

    char at(int byte_index)
    {
        if (byte_index < 0 || byte_index >= stored_length)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        return data[byte_index];
    }

    char front()
    {
        if (stored_length <= 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        return data[0];
    }

    char back()
    {
        if (stored_length <= 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        return data[stored_length - 1];
    }

    int strnlen(int request)
    {
        int result;
        if (request < 0)
        {
            invalid_argument error;
            error.code = 2;
            throw error;
        }
        result = stored_length;
        if (request < result)
        {
            result = request;
        }
        return result;
    }

    int strcmp(string source)
    {
        int index;
        int limit;
        int result;
        int source_length;
        int left_byte;
        int right_byte;
        result = 0;
        index = 0;
        limit = stored_length;
        source_length = source.stored_length;
        if (source_length < limit)
        {
            limit = source_length;
        }
        while (index < limit)
        {
            left_byte = std::ord(data[index]) - 1;
            right_byte = std::ord(source.data[index]) - 1;
            if (left_byte < right_byte)
            {
                result = -1;
                index = limit;
            }
            else
            {
                if (left_byte > right_byte)
                {
                    result = 1;
                    index = limit;
                }
                else
                {
                    index = index + 1;
                }
            }
        }
        if (result == 0)
        {
            if (stored_length < source_length)
            {
                result = -1;
            }
            else
            {
                if (stored_length > source_length)
                {
                    result = 1;
                }
            }
        }
        return result;
    }

    void strcpy(string source)
    {
        int index;
        int source_length;
        char current;
        source_length = source.stored_length;
        reserve_storage(source_length + 1);
        index = 0;
        while (index < source_length)
        {
            current = source.data[index];
            data[index] = current;
            index = index + 1;
        }
        stored_length = source_length;
        data[stored_length] = '\0';
    }

    void strncpy(string source, int request)
    {
        int index;
        int copy_limit;
        int source_length;
        char current;
        source_length = source.stored_length;
        copy_limit = request;
        if (copy_limit < 0)
        {
            invalid_argument error;
            error.code = 2;
            throw error;
        }
        if (copy_limit > source_length)
        {
            copy_limit = source_length;
        }
        if (copy_limit < source_length && copy_limit > 0)
        {
            current = source.data[copy_limit];
            if (std::ord(current) - 1 >= 128)
            {
                if (std::ord(current) - 1 <= 191)
                {
                    invalid_argument error;
                    error.code = 2;
                    throw error;
                }
            }
        }
        reserve_storage(copy_limit + 1);
        clear();
        index = 0;
        while (index < copy_limit)
        {
            current = source.data[index];
            data[index] = current;
            index = index + 1;
        }
        stored_length = copy_limit;
        data[stored_length] = '\0';
    }

    int memcmp(string source, int count)
    {
        int index;
        int limit;
        int result;
        int source_length;
        char current;
        result = 0;
        source_length = source.stored_length;
        if (count < 0 || count > stored_length || count > source_length)
        {
            invalid_argument error;
            error.code = 2;
            throw error;
        }
        limit = count;
        index = 0;
        while (index < limit)
        {
            current = source.data[index];
            if (data[index] < current)
            {
                result = -1;
                index = limit;
            }
            else
            {
                if (data[index] > current)
                {
                    result = 1;
                    index = limit;
                }
                else
                {
                    index = index + 1;
                }
            }
        }
        return result;
    }

    void strcat(string left, string right)
    {
        int left_length;
        int right_length;
        int index;
        int write_offset;
        char current;
        left_length = left.stored_length;
        right_length = right.stored_length;
        if (right_length > 999999998 - left_length)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        reserve_storage(left_length + right_length + 1);
        clear();
        index = 0;
        while (index < left_length)
        {
            current = left.data[index];
            data[index] = current;
            index = index + 1;
        }
        write_offset = index;
        index = 0;
        while (index < right_length)
        {
            current = right.data[index];
            data[write_offset + index] = current;
            index = index + 1;
        }
        stored_length = left_length + right_length;
        data[stored_length] = '\0';
    }

    double parse_double()
    {
        double result;
        double fraction_value;
        double fractional_place;
        double previous_fractional_place;
        double tail_fractional_value;
        double maximum_magnitude;
        double maximum_coefficient;
        int index;
        int end;
        int negative;
        int seen_digit;
        int seen_dot;
        int nonzero_digit;
        int scale_index;
        int digit;
        char current;
        result = 0;
        fraction_value = 0;
        fractional_place = 1;
        fractional_place = fractional_place / 10;
        previous_fractional_place = 0;
        tail_fractional_value = 0;
        maximum_magnitude = 1;
        maximum_coefficient = 1;
        maximum_coefficient = maximum_coefficient * 10 + 7;
        maximum_coefficient = maximum_coefficient * 10 + 9;
        maximum_coefficient = maximum_coefficient * 10 + 7;
        maximum_coefficient = maximum_coefficient * 10 + 6;
        maximum_coefficient = maximum_coefficient * 10 + 9;
        maximum_coefficient = maximum_coefficient * 10 + 3;
        maximum_coefficient = maximum_coefficient * 10 + 1;
        maximum_coefficient = maximum_coefficient * 10 + 3;
        maximum_coefficient = maximum_coefficient * 10 + 4;
        maximum_coefficient = maximum_coefficient * 10 + 8;
        maximum_coefficient = maximum_coefficient * 10 + 6;
        maximum_coefficient = maximum_coefficient * 10 + 2;
        maximum_coefficient = maximum_coefficient * 10 + 3;
        maximum_coefficient = maximum_coefficient * 10 + 1;
        maximum_coefficient = maximum_coefficient * 10 + 5;
        maximum_coefficient = maximum_coefficient * 10 + 7;
        scale_index = 0;
        while (scale_index < 292)
        {
            maximum_magnitude = maximum_magnitude * 10;
            scale_index = scale_index + 1;
        }
        maximum_magnitude = maximum_magnitude * maximum_coefficient;
        index = 0;
        end = stored_length;
        negative = 0;
        seen_digit = 0;
        seen_dot = 0;
        nonzero_digit = 0;
        while (index < end
            && is_ascii_whitespace_byte(std::ord(data[index]) - 1) == 1)
        {
            index = index + 1;
        }
        while (end > index
            && is_ascii_whitespace_byte(std::ord(data[end - 1]) - 1) == 1)
        {
            end = end - 1;
        }
        if (index < end && data[index] == '-')
        {
            negative = 1;
            index = index + 1;
        }
        else
        {
            if (index < end && data[index] == '+')
            {
                index = index + 1;
            }
        }
        if (index >= end)
        {
            parse_error error;
            error.code = 1;
            throw error;
        }
        while (index < end)
        {
            current = data[index];
            digit = std::ord(current) - std::ord('0');
            if (digit >= 0 && digit <= 9)
            {
                if (digit > 0)
                {
                    nonzero_digit = 1;
                }
                if (seen_dot == 0)
                {
                    if (result > (maximum_magnitude - digit) / 10)
                    {
                        range_error error;
                        error.code = 1;
                        throw error;
                    }
                    result = result * 10 + digit;
                    if (result > maximum_magnitude)
                    {
                        range_error error;
                        error.code = 1;
                        throw error;
                    }
                }
                else
                {
                    if (fractional_place > 0)
                    {
                        fraction_value = fraction_value
                            + digit * fractional_place;
                        previous_fractional_place = fractional_place;
                        fractional_place = fractional_place / 10;
                    }
                    else
                    {
                        if (previous_fractional_place > 0)
                        {
                            tail_fractional_value = previous_fractional_place
                                * digit;
                            tail_fractional_value = tail_fractional_value / 10;
                            fraction_value = fraction_value
                                + tail_fractional_value;
                            previous_fractional_place = 0;
                        }
                    }
                }
                seen_digit = 1;
            }
            else
            {
                if (current == '.' && seen_dot == 0)
                {
                    seen_dot = 1;
                }
                else
                {
                    parse_error error;
                    error.code = 2;
                    throw error;
                }
            }
            index = index + 1;
        }
        if (seen_digit == 0)
        {
            parse_error error;
            error.code = 1;
            throw error;
        }
        if (fraction_value > 0)
        {
            if (result > maximum_magnitude - fraction_value)
            {
                range_error error;
                error.code = 1;
                throw error;
            }
            result = result + fraction_value;
        }
        if (result > maximum_magnitude)
        {
            range_error error;
            error.code = 1;
            throw error;
        }
        if (result == 0 && nonzero_digit == 1)
        {
            range_error error;
            error.code = 2;
            throw error;
        }
        if (negative == 1)
        {
            result = 0 - result;
        }
        return result;
    }

    void toupper()
    {
        int index;
        int byte_value;
        char current;
        index = 0;
        while (index < stored_length)
        {
            current = data[index];
            byte_value = std::ord(current) - 1;
            if (byte_value >= 97 && byte_value <= 122)
            {
                data[index] = current - 32;
            }
            index = index + 1;
        }
    }

    void tolower()
    {
        int index;
        int byte_value;
        char current;
        index = 0;
        while (index < stored_length)
        {
            current = data[index];
            byte_value = std::ord(current) - 1;
            if (byte_value >= 65 && byte_value <= 90)
            {
                data[index] = current + 32;
            }
            index = index + 1;
        }
    }
};
