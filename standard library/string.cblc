        while (index < byte_position)
        {
            replacement[index] = data[index];
            index = index + 1;
        }
        index = 0;
        while (index < source_length)
        {
            replacement[byte_position + index] = source.data[index];
            index = index + 1;
        }
        index = byte_position;
        while (index < stored_length)
        {
            replacement[source_length + index] = data[index];
            index = index + 1;
        }
        replacement[result_length] = '\0';
        delete[] data;
        data = replacement;
