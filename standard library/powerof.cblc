void F(double base, double exponent, double result, int status)
{
    status = 0;
    result = 0;
    if (base == 0 && exponent <= 0)
    {
        status = 1;
    }
    else
    {
        if (base < 0)
        {
            result = std::floor(exponent);
            if (exponent != result)
            {
                status = 1;
                result = 0;
            }
            else
            {
                result = std::pow(base, exponent);
            }
        }
        else
        {
            result = std::pow(base, exponent);
        }
    }
}
