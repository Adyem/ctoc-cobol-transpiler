double F(double base, double exponent)
{
    double result;
    domain_error error;
    result = 0;
    if (base == 0 && exponent <= 0)
    {
        error.code = 1;
        throw error;
    }
    else
    {
        if (base < 0)
        {
            result = std::floor(exponent);
            if (exponent != result)
            {
                error.code = 1;
                throw error;
            }
            else
            {
                result = std::pow(base, exponent);
            }
        }
        else
        {
            result = std::pow(base, exponent);
        }
    }
    return result;
}
