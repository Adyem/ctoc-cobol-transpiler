void F(char *first_char, int first_length, char *second_char, int second_length, int count, int result)
{
    int index;
    int limit;
    result = 0;
    limit = count;
    if (limit < 0)
    {
        limit = 0;
    }
    if (limit > first_length)
    {
        limit = first_length;
    }
    if (limit > second_length)
    {
        limit = second_length;
    }
    if (limit > 255)
    {
        limit = 255;
    }
    index = 0;
    while (index < limit)
    {
        if (first_char[index] < second_char[index])
        {
            result = -1;
            index = limit;
        }
        else
        {
            if (first_char[index] > second_char[index])
            {
                result = 1;
                index = limit;
            }
            else
            {
                index = index + 1;
            }
        }
    }
    if (result == 0)
    {
        if (first_length < second_length && first_length < count)
        {
            result = -1;
        }
        else
        {
            if (second_length < first_length && second_length < count)
            {
                result = 1;
            }
        }
    }
}
