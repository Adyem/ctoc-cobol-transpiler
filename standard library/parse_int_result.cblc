struct ParseIntResult
{
    int value;
    int consumed;
    int error;
};

ParseIntResult F(char *source, int source_length)
{
    ParseIntResult result;
    int index;
    int negative;
    int seen_digit;
    int digit_count;
    int digit;
    char current;

    result.value = 0;
    result.consumed = 0;
    result.error = 0;
    index = 0;
    negative = 0;
    seen_digit = 0;
    digit_count = 0;
    while (index < source_length && source[index] == ' ')
    {
        index = index + 1;
    }
    if (index < source_length && source[index] == '-')
    {
        negative = 1;
        index = index + 1;
    }
    else
    {
        if (index < source_length && source[index] == '+')
        {
            index = index + 1;
        }
    }
    while (index < source_length)
    {
        current = source[index];
        if (current >= '0' && current <= '9')
        {
            digit = std::ord(current) - std::ord('0');
            result.value = result.value * 10 + digit;
            digit_count = digit_count + 1;
            seen_digit = 1;
            index = index + 1;
        }
        else
        {
            if (current == ' ')
            {
                index = source_length;
            }
            else
            {
                result.error = 3;
                index = source_length;
            }
        }
    }
    if (seen_digit == 0)
    {
        result.error = 1;
    }
    if (digit_count > 9)
    {
        result.error = 2;
        result.value = 0;
    }
    if (negative == 1)
    {
        result.value = 0 - result.value;
    }
    result.consumed = index;
    return result;
}
