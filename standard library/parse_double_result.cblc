struct ParseDoubleResult
{
    double value;
    int consumed;
    int error;
};

ParseDoubleResult F(char *source, int source_length)
{
    ParseDoubleResult result;
    int index;
    int negative;
    int seen_digit;
    int seen_dot;
    int decimal_places;
    int digit;
    char current;

    result.value = 0;
    result.consumed = 0;
    result.error = 0;
    index = 0;
    negative = 0;
    seen_digit = 0;
    seen_dot = 0;
    decimal_places = 0;
    while (index < source_length && source[index] == ' ')
    {
        index = index + 1;
    }
    if (index < source_length && source[index] == '-')
    {
        negative = 1;
        index = index + 1;
    }
    else
    {
        if (index < source_length && source[index] == '+')
        {
            index = index + 1;
        }
    }
    while (index < source_length)
    {
        current = source[index];
        if (current >= '0' && current <= '9')
        {
            digit = std::ord(current) - std::ord('0');
            result.value = result.value * 10 + digit;
            seen_digit = 1;
            if (seen_dot == 1)
            {
                decimal_places = decimal_places + 1;
            }
            index = index + 1;
        }
        else
        {
            if (current == '.' && seen_dot == 0)
            {
                seen_dot = 1;
                index = index + 1;
            }
            else
            {
                if (current == ' ')
                {
                    index = source_length;
                }
                else
                {
                    result.error = 3;
                    index = source_length;
                }
            }
        }
    }
    if (seen_digit == 0)
    {
        result.error = 1;
    }
    while (decimal_places > 0)
    {
        result.value = result.value / 10;
        decimal_places = decimal_places - 1;
    }
    if (negative == 1)
    {
        result.value = 0 - result.value;
    }
    result.consumed = index;
    return result;
}
