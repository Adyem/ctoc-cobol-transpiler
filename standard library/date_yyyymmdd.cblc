void F(char *input, int year, int month, int day, int packed, int serial, int status)
{
    int index;
    int digit;
    int month_base;
    int max_day;
    int leap_year;
    int previous_year;
    int leap_count;
    char current;
    status = 0;
    packed = 0;
    index = 0;
    while (index < 8)
    {
        current = input[index];
        digit = std::ord(current) - 49;
        packed = packed * 10 + digit;
        index = index + 1;
    }
    year = packed / 10000;
    month_base = packed / 100;
    month = month_base - year * 100;
    day = packed - month_base * 100;
    max_day = 31;
    leap_year = 0;
    if (year / 4 * 4 == year)
    {
        leap_year = 1;
    }
    if (year / 100 * 100 == year)
    {
        leap_year = 0;
    }
    if (year / 400 * 400 == year)
    {
        leap_year = 1;
    }
    if (month == 4)
    {
        max_day = 30;
    }
    if (month == 6)
    {
        max_day = 30;
    }
    if (month == 9)
    {
        max_day = 30;
    }
    if (month == 11)
    {
        max_day = 30;
    }
    if (month == 2)
    {
        max_day = 28;
        if (leap_year == 1)
        {
            max_day = 29;
        }
    }
    if (month < 1)
    {
        status = 2;
    }
    if (month > 12)
    {
        status = 2;
    }
    if (day < 1)
    {
        status = 3;
    }
    if (day > max_day)
    {
        status = 3;
    }
    if (status != 0)
    {
        year = 0;
        month = 0;
        day = 0;
        packed = 0;
        serial = 0;
    }
    if (status == 0)
    {
        previous_year = year;
        previous_year = previous_year - 1;
        serial = year;
        serial = serial - 1601;
        serial = serial * 365;
        leap_count = previous_year;
        leap_count = leap_count / 4;
        leap_count = leap_count - 400;
        serial = serial + leap_count;
        leap_count = previous_year;
        leap_count = leap_count / 100;
        leap_count = leap_count - 16;
        serial = serial - leap_count;
        leap_count = previous_year;
        leap_count = leap_count / 400;
        leap_count = leap_count - 4;
        serial = serial + leap_count;
        serial = serial + day;
        if (month > 1)
        {
            serial = serial + 31;
        }
        if (month > 2)
        {
            serial = serial + 28;
        }
        if (month > 2 && leap_year == 1)
        {
            serial = serial + 1;
        }
        if (month > 3)
        {
            serial = serial + 31;
        }
        if (month > 4)
        {
            serial = serial + 30;
        }
        if (month > 5)
        {
            serial = serial + 31;
        }
        if (month > 6)
        {
            serial = serial + 30;
        }
        if (month > 7)
        {
            serial = serial + 31;
        }
        if (month > 8)
        {
            serial = serial + 31;
        }
        if (month > 9)
        {
            serial = serial + 30;
        }
        if (month > 10)
        {
            serial = serial + 31;
        }
        if (month > 11)
        {
            serial = serial + 30;
        }
    }
}
