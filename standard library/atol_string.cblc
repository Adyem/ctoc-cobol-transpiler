int F(string source)
{
    int result;
    int index;
    int negative;
    int digit;
    char current;
    result = 0;
    index = 0;
    negative = 0;
    while (index < source.len)
    {
        if (source[index] == ' ')
        {
            index = index + 1;
        }
        else
        {
            index = source.len;
        }
    }
    if (source[index] == '-')
    {
        negative = 1;
        index = index + 1;
    }
    else
    {
        if (source[index] == '+')
        {
            index = index + 1;
        }
    }
    while (index < source.len)
    {
        if (source[index] < '0')
        {
            index = source.len;
        }
        else
        {
            if (source[index] > '9')
            {
                index = source.len;
            }
            else
            {
                current = source[index];
                digit = std::ord(current) + 0;
                result = result * 10 + digit - 48;
                index = index + 1;
            }
        }
    }
    if (negative == 1)
    {
        result = 0 - result;
    }
    return result;
}
