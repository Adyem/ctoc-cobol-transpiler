double F(double operand)
{
    double result;
    int parity;
    result = std::floor(operand);
    if (operand != result)
    {
        parity = result;
        parity = parity / 2;
        if (operand >= 0)
        {
            if (parity * 2 != result)
            {
                result = result + 1;
            }
        }
        else
        {
            if (parity * 2 != result)
            {
                result = result - 1;
            }
        }
    }
    return result;
}
