void F(string destination, string source, int request, int status)
{
    int index;
    int copy_limit;
    status = 0;
    copy_limit = request;
    if (copy_limit < 0)
    {
        copy_limit = 0;
    }
    if (copy_limit > source.len)
    {
        copy_limit = source.len;
        status = 1;
    }
    if (copy_limit > 255)
    {
        copy_limit = 255;
        status = 1;
    }
    destination = "";
    index = 0;
    while (index < copy_limit)
    {
        destination[index] = source[index];
        index = index + 1;
    }
}
