template <typename T>
class vector
{
    private:
    T *data;
    T *relocation;
    int count;
    int reserved;
    int relocation_index;

    public:
    vector()
    {
        data = NULL;
        relocation = NULL;
        count = 0;
        reserved = 0;
        relocation_index = 0;
    }

    vector(vector source)
    {
        data = NULL;
        relocation = NULL;
        count = source.count;
        reserved = source.reserved;
        relocation_index = 0;
        if (reserved > 0)
        {
            try
            {
                relocation = new T[reserved];
                while (relocation_index < count)
                {
                    relocation[relocation_index] = source.data[relocation_index];
                    relocation_index = relocation_index + 1;
                }
            }
            catch (...)
            {
                if (relocation != NULL)
                {
                    delete[] relocation;
                }
                relocation = NULL;
                relocation_index = 0;
                throw;
            }
            data = relocation;
            relocation = NULL;
            relocation_index = 0;
        }
    }

    void operator=(vector source)
    {
        relocation = NULL;
        relocation_index = 0;
        if (source.reserved > 0)
        {
            try
            {
                relocation = new T[source.reserved];
                while (relocation_index < source.count)
                {
                    relocation[relocation_index] = source.data[relocation_index];
                    relocation_index = relocation_index + 1;
                }
            }
            catch (...)
            {
                if (relocation != NULL)
                {
                    delete[] relocation;
                }
                relocation = NULL;
                relocation_index = 0;
                throw;
            }
        }
        if (data != NULL)
        {
            delete[] data;
        }
        data = NULL;
        count = source.count;
        reserved = source.reserved;
        data = relocation;
        relocation = NULL;
        relocation_index = 0;
    }

    ~vector()
    {
        delete[] data;
    }

    int size()
    {
        return count;
    }

    int capacity()
    {
        return reserved;
    }

    int max_size()
    {
        return 2147483647;
    }

    int empty()
    {
        if (count == 0)
        {
            return 1;
        }
        return 0;
    }

    void reserve(int requested)
    {
        if (requested < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested > reserved && requested > 0)
        {
            relocation = NULL;
            relocation_index = 0;
            try
            {
                relocation = new T[requested];
                while (relocation_index < count)
                {
                    relocation[relocation_index] = data[relocation_index];
                    relocation_index = relocation_index + 1;
                }
            }
            catch (...)
            {
                if (relocation != NULL)
                {
                    delete[] relocation;
                }
                relocation = NULL;
                relocation_index = 0;
                throw;
            }
            delete[] data;
            data = relocation;
            relocation = NULL;
            reserved = requested;
        }
    }

    void ensure_capacity_for_one()
    {
        int requested;

        if (count < reserved)
        {
            return;
        }
        if (reserved >= 2147483647)
        {
            length_error error;
            error.code = 1;
            throw error;
        }
        if (reserved < 1)
        {
            requested = 1;
        }
        else
        {
            if (reserved > 1073741823)
            {
                requested = 2147483647;
            }
            else
            {
                requested = reserved * 2;
            }
        }
        reserve(requested);
    }

    void shrink_to_fit()
    {
        if (count < reserved)
        {
            if (count == 0)
            {
                delete[] data;
                data = NULL;
                relocation = NULL;
                reserved = 0;
            }
            else
            {
                relocation = NULL;
                relocation_index = 0;
                try
                {
                    relocation = new T[count];
                    while (relocation_index < count)
                    {
                        relocation[relocation_index] = data[relocation_index];
                        relocation_index = relocation_index + 1;
                    }
                }
                catch (...)
                {
                    if (relocation != NULL)
                    {
                        delete[] relocation;
                    }
                    relocation = NULL;
                    relocation_index = 0;
                    throw;
                }
                delete[] data;
                data = relocation;
                relocation = NULL;
                reserved = count;
            }
        }
    }

    void push_back(T value)
    {
        if (count >= reserved)
        {
            ensure_capacity_for_one();
        }
        data[count] = value;
        count = count + 1;
    }

    void pop_back()
    {
        if (count <= 0)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        count = count - 1;
    }

    T& at(int index)
    {
        check_index(index);
        return data[index];
    }

    T& front()
    {
        check_index(0);
        return data[0];
    }

    T& back()
    {
        check_index(count - 1);
        return data[count - 1];
    }

    T *operator[](int index)
    {
        check_index(index);
        return data + index;
    }

    T *operator->()
    {
        check_index(0);
        return data + 0;
    }

    void emplace_back(T value)
    {
        if (count >= reserved)
        {
            ensure_capacity_for_one();
        }
        data[count] = value;
        count = count + 1;
    }

    void insert(int index, T value)
    {
        int shift;

        if (index < 0 || index > count)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        if (count >= reserved)
        {
            ensure_capacity_for_one();
        }
        shift = count;
        while (shift > index)
        {
            data[shift] = data[shift - 1];
            shift = shift - 1;
        }
        data[index] = value;
        count = count + 1;
    }

    void erase(int index)
    {
        int shift;

        if (index < 0 || index >= count)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
        shift = index;
        while (shift < count - 1)
        {
            data[shift] = data[shift + 1];
            shift = shift + 1;
        }
        count = count - 1;
    }


    void clear()
    {
        count = 0;
    }

    void assign(int requested, T value)
    {
        if (requested < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested > reserved)
        {
            reserve(requested);
        }
        count = 0;
        while (count < requested)
        {
            data[count] = value;
            count = count + 1;
        }
    }

    void resize(int requested)
    {
        if (requested < 0)
        {
            invalid_argument error;
            error.code = 1;
            throw error;
        }
        if (requested > reserved)
        {
            reserve(requested);
        }
        count = requested;
    }

    private:
    void check_index(int index)
    {
        if (index < 0 || index >= count)
        {
            out_of_range error;
            error.code = 1;
            throw error;
        }
    }
};
