double F(char *source_char, int source_length)
{
    double result;
    int index;
    int negative;
    int started;
    int seen_digit;
    int seen_dot;
    int decimal_places;
    int digit;
    invalid_argument error;
    char current;
    result = 0;
    index = 0;
    negative = 0;
    started = 0;
    seen_digit = 0;
    seen_dot = 0;
    decimal_places = 0;
    while (index < source_length && started == 0)
    {
        current = source_char[index];
        if (current == ' ')
        {
            index = index + 1;
        }
        else
        {
            started = 1;
        }
    }
    if (started == 1 && source_char[index] == '-')
    {
        negative = 1;
        index = index + 1;
    }
    else
    {
        if (started == 1 && source_char[index] == '+')
        {
            index = index + 1;
        }
    }
    while (index < source_length)
    {
        current = source_char[index];
        if (current >= '0' && current <= '9')
        {
            digit = std::ord(current) - std::ord('0');
            result = result * 10 + digit;
            seen_digit = 1;
            if (seen_dot == 1)
            {
                decimal_places = decimal_places + 1;
            }
            index = index + 1;
        }
        else
        {
            if (current == '.' && seen_dot == 0)
            {
                seen_dot = 1;
                index = index + 1;
            }
            else
            {
                if (current == ' ')
                {
                    index = source_length;
                }
                else
                {
                    error.code = 1;
                    throw error;
                    result = 0;
                    index = source_length;
                }
            }
        }
    }
    if (seen_digit == 0)
    {
        error.code = 1;
        throw error;
    }
    while (decimal_places > 0)
    {
        result = result / 10;
        decimal_places = decimal_places - 1;
    }
    if (negative == 1)
    {
        result = 0 - result;
    }
    return result;
}
