int F(char *source_char, int declared_length, int request)
{
    int result;
    int index;
    int limit;
    result = 0;
    index = 0;
    limit = declared_length;
    if (request < limit)
    {
        limit = request;
    }
    if (limit < 0)
    {
        limit = 0;
    }
    while (index < limit)
    {
        if (source_char[index] == '\0')
        {
            index = limit;
        }
        else
        {
            if (source_char[index] != ' ')
            {
                result = index + 1;
            }
            index = index + 1;
        }
    }
    return result;
}
