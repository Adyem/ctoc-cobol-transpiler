void F(char *first_char, int first_length, char *second_char, int second_length, int result)
{
    int index;
    int limit;
    result = 0;
    index = 0;
    limit = first_length;
    if (second_length < limit)
    {
        limit = second_length;
    }
    while (index < limit)
    {
        if (first_char[index] < second_char[index])
        {
            result = -1;
            index = limit;
        }
        else
        {
            if (first_char[index] > second_char[index])
            {
                result = 1;
                index = limit;
            }
            else
            {
                index = index + 1;
            }
        }
    }
    if (result == 0)
    {
        if (first_length < second_length)
        {
            result = -1;
        }
        else
        {
            if (first_length > second_length)
            {
                result = 1;
            }
        }
    }
}
