void F(int start_serial, int end_serial, int duration, int comparison, int status)
{
    status = 0;
    duration = end_serial - start_serial;
    comparison = 0;
    if (duration < 0)
    {
        comparison = -1;
        duration = 0 - duration;
    }
    else
    {
        if (duration > 0)
        {
            comparison = 1;
        }
    }
}
