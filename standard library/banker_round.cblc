double F(double operand, int scale)
{
    double result;
    int index;
    invalid_argument error;
    if (scale < 0 || scale > 18)
    {
        error.code = 2;
        throw error;
    }
    else
    {
        result = operand;
        index = 0;
        while (index < scale)
        {
            result = result * 10;
            index = index + 1;
        }
        result = std::floor(result);
        index = 0;
        while (index < scale)
        {
            result = result / 10;
            index = index + 1;
        }
    }
    return result;
}
